#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/workspace/node_modules/conventional-changelog-writer/dist/cli/node_modules:/home/runner/workspace/node_modules/conventional-changelog-writer/dist/node_modules:/home/runner/workspace/node_modules/conventional-changelog-writer/node_modules:/home/runner/workspace/node_modules:/home/runner/node_modules:/home/node_modules:/node_modules:/home/runner/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/workspace/node_modules/conventional-changelog-writer/dist/cli/node_modules:/home/runner/workspace/node_modules/conventional-changelog-writer/dist/node_modules:/home/runner/workspace/node_modules/conventional-changelog-writer/node_modules:/home/runner/workspace/node_modules:/home/runner/node_modules:/home/node_modules:/node_modules:/home/runner/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../conventional-changelog-writer/dist/cli/index.js" "$@"
else
  exec node  "$basedir/../conventional-changelog-writer/dist/cli/index.js" "$@"
fi
