#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules/@deriv/js-interpreter/lib/node_modules:/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules/@deriv/js-interpreter/node_modules:/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules/@deriv/node_modules:/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules:/home/runner/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules/@deriv/js-interpreter/lib/node_modules:/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules/@deriv/js-interpreter/node_modules:/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules/@deriv/node_modules:/home/runner/workspace/node_modules/.pnpm/@deriv+js-interpreter@3.0.0/node_modules:/home/runner/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@deriv/js-interpreter/lib/cli.min.js" "$@"
else
  exec node  "$basedir/../@deriv/js-interpreter/lib/cli.min.js" "$@"
fi
