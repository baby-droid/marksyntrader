<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="stake_var">stake</variable>
    <variable id="init_stake_var">initial_stake</variable>
    <variable id="total_profit_var">total_profit</variable>
    <variable id="total_loss_var">total_loss</variable>
    <variable id="martingale_var">martingale</variable>
    <variable id="contract_switch_var">contract_type_index</variable>
  </variables>
  <block type="trade_definition" id="mkp_main" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="mkp_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="mkp_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="mkp_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITOVER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="mkp_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="mkp_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="mkp_restarterr" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="mkp_init_stake">
        <field name="VAR" id="stake_var">stake</field>
        <value name="VALUE">
          <block type="math_number" id="mkp_stake_val">
            <field name="NUM">0.35</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="mkp_init_stake2">
            <field name="VAR" id="init_stake_var">initial_stake</field>
            <value name="VALUE">
              <block type="math_number" id="mkp_init_stake_val">
                <field name="NUM">0.35</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="mkp_init_tp">
                <field name="VAR" id="total_profit_var">total_profit</field>
                <value name="VALUE">
                  <block type="math_number" id="mkp_tp_val">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="mkp_init_tl">
                    <field name="VAR" id="total_loss_var">total_loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="mkp_tl_val">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="mkp_init_mart">
                        <field name="VAR" id="martingale_var">martingale</field>
                        <value name="VALUE">
                          <block type="math_number" id="mkp_mart_val">
                            <field name="NUM">2.2</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="mkp_init_switch">
                            <field name="VAR" id="contract_switch_var">contract_type_index</field>
                            <value name="VALUE">
                              <block type="math_number" id="mkp_switch_val">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="BEFORE_PURCHASE">
      <block type="purchase" id="mkp_purchase">
        <field name="PURCHASE_LIST">DIGITOVER</field>
        <value name="AMOUNT">
          <block type="variables_get" id="mkp_stake_get">
            <field name="VAR" id="stake_var">stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="math_number" id="mkp_pred_val">
            <field name="NUM">2</field>
          </block>
        </value>
        <value name="DURATION">
          <block type="math_number" id="mkp_dur_val">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="DURATION_UNIT">
          <block type="text" id="mkp_dur_unit">
            <field name="TEXT">t</field>
          </block>
        </value>
      </block>
    </statement>
    <statement name="AFTER_PURCHASE">
      <block type="after_purchase_profit" id="mkp_profit_block">
        <statement name="PROFIT_ACTIONS">
          <block type="variables_set" id="mkp_profit_set">
            <field name="VAR" id="total_profit_var">total_profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="mkp_profit_add">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="mkp_profit_get">
                    <field name="VAR" id="total_profit_var">total_profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="contract_profit" id="mkp_contract_profit" />
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="mkp_reset_stake">
                <field name="VAR" id="stake_var">stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="mkp_init_stake_get">
                    <field name="VAR" id="init_stake_var">initial_stake</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="mkp_tp_check">
                    <value name="IF0">
                      <block type="logic_compare" id="mkp_tp_compare">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="variables_get" id="mkp_tp_get">
                            <field name="VAR" id="total_profit_var">total_profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="mkp_tp_target">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="bot_notification" id="mkp_tp_notify">
                        <field name="NOTIFICATION_TYPE">success</field>
                        <value name="MESSAGE">
                          <block type="text" id="mkp_tp_msg">
                            <field name="TEXT">🏆 TAKE PROFIT HIT — Market Killer Prime V1</field>
                          </block>
                        </value>
                        <next>
                          <block type="trade_again" id="mkp_tp_stop" />
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="LOSS_ACTIONS">
          <block type="variables_set" id="mkp_loss_set">
            <field name="VAR" id="total_loss_var">total_loss</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="mkp_loss_add">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get" id="mkp_loss_get">
                    <field name="VAR" id="total_loss_var">total_loss</field>
                  </block>
                </value>
                <value name="B">
                  <block type="contract_profit" id="mkp_contract_loss" />
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="mkp_mart_stake">
                <field name="VAR" id="stake_var">stake</field>
                <value name="VALUE">
                  <block type="math_round" id="mkp_mart_round">
                    <field name="OP">ROUND</field>
                    <value name="NUM">
                      <block type="math_arithmetic" id="mkp_mart_mult">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="variables_get" id="mkp_stake_get2">
                            <field name="VAR" id="stake_var">stake</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="mkp_mart_get">
                            <field name="VAR" id="martingale_var">martingale</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="mkp_sl_check">
                    <value name="IF0">
                      <block type="logic_compare" id="mkp_sl_compare">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="mkp_sl_get">
                            <field name="VAR" id="total_loss_var">total_loss</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="mkp_sl_target">
                            <field name="NUM">-1000</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="bot_notification" id="mkp_sl_notify">
                        <field name="NOTIFICATION_TYPE">danger</field>
                        <value name="MESSAGE">
                          <block type="text" id="mkp_sl_msg">
                            <field name="TEXT">🛑 STOP LOSS HIT — Market Killer Prime V1</field>
                          </block>
                        </value>
                        <next>
                          <block type="trade_again" id="mkp_sl_stop" />
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
