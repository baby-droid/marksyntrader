<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <!--
    AHMED DIFFER CYCLE
    These three root sections are the executable Blockly equivalent of the
    shared SVG blocks:
      gt.seq.tradeDef
      gt.seq.beforePurchase
      gt.seq.afterPurchase
    The SVG files are rendered fragments and cannot be passed to Blockly.load
    directly. The data tags below preserve their shared-block identities.
  -->
  <variables>
    <variable id="adc_stake">stake</variable>
    <variable id="adc_initial">initial_stake</variable>
    <variable id="adc_martingale">martingale</variable>
    <variable id="adc_phase">cycle_phase</variable>
    <variable id="adc_digit">last_digit</variable>
  </variables>

  <block type="trade_definition" id="adc_trade_definition" deletable="false" x="0" y="60">
    <data>gt.seq.tradeDef</data>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="adc_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="adc_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="adc_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="adc_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="adc_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="adc_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="adc_set_stake">
        <field name="VAR" id="adc_stake">stake</field>
        <value name="VALUE"><block type="math_number" id="adc_stake_value"><field name="NUM">0.5</field></block></value>
        <next>
          <block type="variables_set" id="adc_set_initial">
            <field name="VAR" id="adc_initial">initial_stake</field>
            <value name="VALUE"><block type="math_number" id="adc_initial_value"><field name="NUM">0.5</field></block></value>
            <next>
              <block type="variables_set" id="adc_set_martingale">
                <field name="VAR" id="adc_martingale">martingale</field>
                <value name="VALUE"><block type="math_number" id="adc_martingale_value"><field name="NUM">2</field></block></value>
                <next>
                  <block type="variables_set" id="adc_set_phase">
                    <field name="VAR" id="adc_phase">cycle_phase</field>
                    <value name="VALUE"><block type="math_number" id="adc_phase_value"><field name="NUM">0</field></block></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="adc_before_purchase" deletable="false" x="0" y="850">
    <data>gt.seq.beforePurchase</data>
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="adc_capture_digit">
        <field name="VAR" id="adc_digit">last_digit</field>
        <value name="VALUE"><block type="last_digit" id="adc_last_digit"></block></value>
        <next>
          <block type="controls_if" id="adc_cycle_router">
            <mutation elseif="2" else="1"></mutation>
            <value name="IF0"><block type="logic_compare" id="adc_phase_0_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_0_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number" id="adc_phase_0_num"><field name="NUM">0</field></block></value></block></value>
            <statement name="DO0"><block type="multiple_purchase" id="adc_purchase_differ"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"></field><field name="PURCHASE_3"></field><field name="PURCHASE_4"></field><field name="PURCHASE_5"></field><field name="PURCHASE_6"></field><field name="PREDICTION">LAST_DIGIT</field></block></statement>
            <value name="IF1"><block type="logic_compare" id="adc_phase_1_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_1_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number" id="adc_phase_1_num"><field name="NUM">1</field></block></value></block></value>
            <statement name="DO1"><block type="multiple_purchase" id="adc_purchase_over_1"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"></field><field name="PURCHASE_3"></field><field name="PURCHASE_4"></field><field name="PURCHASE_5"></field><field name="PURCHASE_6"></field><field name="PREDICTION">1</field></block></statement>
            <value name="IF2"><block type="logic_compare" id="adc_phase_2_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_2_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number" id="adc_phase_2_num"><field name="NUM">2</field></block></value></block></value>
            <statement name="DO2"><block type="multiple_purchase" id="adc_purchase_over_2"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"></field><field name="PURCHASE_3"></field><field name="PURCHASE_4"></field><field name="PURCHASE_5"></field><field name="PURCHASE_6"></field><field name="PREDICTION">2</field></block></statement>
            <statement name="ELSE"><block type="purchase" id="adc_purchase_even_recovery"><field name="PURCHASE_LIST">DIGITEVEN</field></block></statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="adc_after_purchase" deletable="false" x="720" y="850">
    <data>gt.seq.afterPurchase</data>
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="adc_result_router">
        <mutation else="1"></mutation>
        <value name="IF0"><block type="check_win" id="adc_check_win"></block></value>
        <statement name="DO0">
          <block type="variables_set" id="adc_reset_stake">
            <field name="VAR" id="adc_stake">stake</field>
            <value name="VALUE"><block type="variables_get" id="adc_reset_stake_value"><field name="VAR" id="adc_initial">initial_stake</field></block></value>
            <next><block type="math_change" id="adc_next_phase_win"><field name="VAR" id="adc_phase">cycle_phase</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="adc_multiply_stake">
            <field name="VAR" id="adc_stake">stake</field>
            <value name="VALUE"><block type="math_arithmetic" id="adc_stake_times_martingale"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="adc_current_stake"><field name="VAR" id="adc_stake">stake</field></block></value><value name="B"><block type="variables_get" id="adc_current_martingale"><field name="VAR" id="adc_martingale">martingale</field></block></value></block></value>
            <next><block type="math_change" id="adc_next_phase_loss"><field name="VAR" id="adc_phase">cycle_phase</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></next>
          </block>
        </statement>
        <next><block type="controls_if" id="adc_phase_wrap"><mutation else="1"></mutation><value name="IF0"><block type="logic_compare" id="adc_phase_wrap_test"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="adc_phase_wrap_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number" id="adc_phase_wrap_num"><field name="NUM">3</field></block></value></block></value><statement name="DO0"><block type="variables_set" id="adc_phase_wrap_set"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number" id="adc_phase_wrap_zero"><field name="NUM">0</field></block></value><next><block type="trade_again" id="adc_trade_again_after_wrap"></block></next></block></statement><statement name="ELSE"><block type="trade_again" id="adc_trade_again"></block></statement></block></next>
      </block>
    </statement>
  </block>
</xml>