<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">

  <!--
    ═══════════════════════════════════════════════════════════════════════
    AHMED AUTO EVEN — Smart DIGITEVEN Entry Bot
    ──────────────────────────────────────────────────────────────────────
    ENTRY 1 (Streak Reversal): streak_threshold consecutive ODD digits
      → first EVEN digit → BUY DIGITEVEN (real stake / martingale)

    ENTRY 2 (Low Odd Digit): last digit == entry_digit_1 OR entry_digit_2
      (lowest-% odd digits, default 1 and 3 — user editable)
      → BUY DIGITEVEN (real stake / martingale)

    SCAN MODE: no signal → buy with scan_stake to track the next digit

    RISK MANAGEMENT:
      Martingale ×2 on every real-trade loss (resets on win).
      Scan-trade loss: no martingale — stake stays at current level.
      Take Profit: session_profit >= take_profit → bot stops.
      Stop Loss:   session_profit <= −stop_loss → bot stops.
      Market: Volatility 25 Index 1s (1HZ25V) | 1 tick
    ═══════════════════════════════════════════════════════════════════════
  -->

  <variables>
    <variable id="aev_stake">stake</variable>
    <variable id="aev_init">initial_stake</variable>
    <variable id="aev_scan">scan_stake</variable>
    <variable id="aev_ms">martingale_stake</variable>
    <variable id="aev_mart">martingale</variable>
    <variable id="aev_tp">take_profit</variable>
    <variable id="aev_sl">stop_loss</variable>
    <variable id="aev_pnl">session_profit</variable>
    <variable id="aev_codd">cons_odd</variable>
    <variable id="aev_cev">cons_even</variable>
    <variable id="aev_real">is_real_trade</variable>
    <variable id="aev_d1">entry_digit_1</variable>
    <variable id="aev_d2">entry_digit_2</variable>
    <variable id="aev_thr">streak_threshold</variable>
    <variable id="aev_ld">last_digit</variable>
  </variables>

  <!-- ═══ TRADE DEFINITION ══════════════════════════════════════════════ -->
  <block type="trade_definition" id="aev_def" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="aev_mkt" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="aev_tt" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="aev_ct" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITEVEN</field>
                <next>
                  <block type="trade_definition_candleinterval" id="aev_ci" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="aev_rbs" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="aev_roe" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- ═══ INITIALIZATION — ★ USER-EDITABLE SETTINGS BELOW ★ ════════ -->
    <statement name="INITIALIZATION">

      <!-- ── Stake & Risk Settings (edit these) ────────────────────── -->
      <block type="variables_set" id="aev_i_init">
        <field name="VAR" id="aev_init">initial_stake</field>
        <value name="VALUE"><block type="math_number" id="aev_i_init_v"><field name="NUM">0.35</field></block></value>
        <next>
          <block type="variables_set" id="aev_i_scan">
            <field name="VAR" id="aev_scan">scan_stake</field>
            <value name="VALUE"><block type="math_number" id="aev_i_scan_v"><field name="NUM">0.35</field></block></value>
            <next>
              <block type="variables_set" id="aev_i_mart">
                <field name="VAR" id="aev_mart">martingale</field>
                <value name="VALUE"><block type="math_number" id="aev_i_mart_v"><field name="NUM">2</field></block></value>
                <next>
                  <block type="variables_set" id="aev_i_tp">
                    <field name="VAR" id="aev_tp">take_profit</field>
                    <value name="VALUE"><block type="math_number" id="aev_i_tp_v"><field name="NUM">5</field></block></value>
                    <next>
                      <block type="variables_set" id="aev_i_sl">
                        <field name="VAR" id="aev_sl">stop_loss</field>
                        <value name="VALUE"><block type="math_number" id="aev_i_sl_v"><field name="NUM">50</field></block></value>
                        <next>

                          <!-- ── Entry 1 — Odd streak length (edit this) ──────── -->
                          <block type="variables_set" id="aev_i_thr">
                            <field name="VAR" id="aev_thr">streak_threshold</field>
                            <value name="VALUE"><block type="math_number" id="aev_i_thr_v"><field name="NUM">3</field></block></value>
                            <next>

                              <!-- ── Entry 2 — Lowest odd % digit (edit these) ── -->
                              <block type="variables_set" id="aev_i_d1">
                                <field name="VAR" id="aev_d1">entry_digit_1</field>
                                <value name="VALUE"><block type="math_number" id="aev_i_d1_v"><field name="NUM">1</field></block></value>
                                <next>
                                  <block type="variables_set" id="aev_i_d2">
                                    <field name="VAR" id="aev_d2">entry_digit_2</field>
                                    <value name="VALUE"><block type="math_number" id="aev_i_d2_v"><field name="NUM">3</field></block></value>
                                    <next>

                                      <!-- ── Internal state — do not modify ── -->
                                      <block type="variables_set" id="aev_i_stake" collapsed="true">
                                        <field name="VAR" id="aev_stake">stake</field>
                                        <value name="VALUE"><block type="variables_get" id="aev_i_sg"><field name="VAR" id="aev_init">initial_stake</field></block></value>
                                        <next>
                                          <block type="variables_set" id="aev_i_ms">
                                            <field name="VAR" id="aev_ms">martingale_stake</field>
                                            <value name="VALUE"><block type="variables_get" id="aev_i_msg"><field name="VAR" id="aev_init">initial_stake</field></block></value>
                                            <next>
                                              <block type="variables_set" id="aev_i_pnl">
                                                <field name="VAR" id="aev_pnl">session_profit</field>
                                                <value name="VALUE"><block type="math_number" id="aev_i_pnl_v"><field name="NUM">0</field></block></value>
                                                <next>
                                                  <block type="variables_set" id="aev_i_codd">
                                                    <field name="VAR" id="aev_codd">cons_odd</field>
                                                    <value name="VALUE"><block type="math_number" id="aev_i_codd_v"><field name="NUM">0</field></block></value>
                                                    <next>
                                                      <block type="variables_set" id="aev_i_cev">
                                                        <field name="VAR" id="aev_cev">cons_even</field>
                                                        <value name="VALUE"><block type="math_number" id="aev_i_cev_v"><field name="NUM">0</field></block></value>
                                                        <next>
                                                          <block type="variables_set" id="aev_i_real">
                                                            <field name="VAR" id="aev_real">is_real_trade</field>
                                                            <value name="VALUE"><block type="math_number" id="aev_i_real_v"><field name="NUM">0</field></block></value>
                                                            <next>
                                                              <block type="text_print" id="aev_i_notif">
                                                                <value name="TEXT"><block type="text" id="aev_i_notif_t"><field name="TEXT">🟢 AHMED AUTO EVEN started — scanning for entry signals...</field></block></value>
                                                              </block>
                                                            </next>
                                                          </block>
                                                        </next>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>

                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>

                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- ═══ TRADE OPTIONS ════════════════════════════════════════════ -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="aev_opts" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number_positive" id="aev_opts_dur"><field name="NUM">1</field></shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number_positive" id="aev_opts_amt_s"><field name="NUM">0.35</field></shadow>
          <block type="variables_get" id="aev_opts_amt"><field name="VAR" id="aev_stake">stake</field></block>
        </value>
      </block>
    </statement>
  </block>

  <!-- ═══ BEFORE PURCHASE ══════════════════════════════════════════════ -->
  <block type="before_purchase" id="aev_bp" deletable="false" x="0" y="680">
    <statement name="BEFOREPURCHASE_STACK">

      <!-- 1. Reset signal flag -->
      <block type="variables_set" id="aev_bp_r">
        <field name="VAR" id="aev_real">is_real_trade</field>
        <value name="VALUE"><block type="math_number" id="aev_bp_r_v"><field name="NUM">0</field></block></value>
        <next>

          <!-- 2. Read last digit -->
          <block type="variables_set" id="aev_bp_ld">
            <field name="VAR" id="aev_ld">last_digit</field>
            <value name="VALUE"><block type="last_digit" id="aev_bp_ldv"></block></value>
            <next>

              <!-- 3. Parity check + streak update + signal detection -->
              <block type="controls_if" id="aev_bp_par">
                <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

                <!-- Condition: digit ∈ {0,2,4,6,8} → EVEN -->
                <value name="IF0">
                  <block type="logic_operation" id="aev_eor1"><field name="OP">OR</field>
                    <value name="A">
                      <block type="logic_compare" id="aev_e0"><field name="OP">EQ</field>
                        <value name="A"><block type="variables_get" id="aev_e0a"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                        <value name="B"><block type="math_number" id="aev_e0b"><field name="NUM">0</field></block></value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_operation" id="aev_eor2"><field name="OP">OR</field>
                        <value name="A">
                          <block type="logic_compare" id="aev_e2"><field name="OP">EQ</field>
                            <value name="A"><block type="variables_get" id="aev_e2a"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                            <value name="B"><block type="math_number" id="aev_e2b"><field name="NUM">2</field></block></value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_operation" id="aev_eor3"><field name="OP">OR</field>
                            <value name="A">
                              <block type="logic_compare" id="aev_e4"><field name="OP">EQ</field>
                                <value name="A"><block type="variables_get" id="aev_e4a"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                                <value name="B"><block type="math_number" id="aev_e4b"><field name="NUM">4</field></block></value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="logic_operation" id="aev_eor4"><field name="OP">OR</field>
                                <value name="A">
                                  <block type="logic_compare" id="aev_e6"><field name="OP">EQ</field>
                                    <value name="A"><block type="variables_get" id="aev_e6a"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                                    <value name="B"><block type="math_number" id="aev_e6b"><field name="NUM">6</field></block></value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="logic_compare" id="aev_e8"><field name="OP">EQ</field>
                                    <value name="A"><block type="variables_get" id="aev_e8a"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                                    <value name="B"><block type="math_number" id="aev_e8b"><field name="NUM">8</field></block></value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>

                <!-- DO0 — EVEN digit: check signal 1, update counters -->
                <statement name="DO0">
                  <!-- Signal 1: was there a long enough odd streak? -->
                  <block type="controls_if" id="aev_sig1">
                    <value name="IF0">
                      <block type="logic_compare" id="aev_sig1_cmp"><field name="OP">GTE</field>
                        <value name="A"><block type="variables_get" id="aev_sig1_a"><field name="VAR" id="aev_codd">cons_odd</field></block></value>
                        <value name="B"><block type="variables_get" id="aev_sig1_b"><field name="VAR" id="aev_thr">streak_threshold</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="aev_sig1_set">
                        <field name="VAR" id="aev_real">is_real_trade</field>
                        <value name="VALUE"><block type="math_number" id="aev_sig1_v"><field name="NUM">1</field></block></value>
                        <next>
                          <block type="notify" id="aev_sig1_n">
                            <field name="NOTIFICATION_TYPE">info</field>
                            <field name="NOTIFICATION_SOUND">ding</field>
                            <value name="MESSAGE">
                              <block type="text_join" id="aev_sig1_nj"><mutation items="3"></mutation>
                                <value name="ADD0"><block type="text" id="aev_s1a"><field name="TEXT">🎯 SIGNAL 1: </field></block></value>
                                <value name="ADD1"><block type="variables_get" id="aev_s1b"><field name="VAR" id="aev_codd">cons_odd</field></block></value>
                                <value name="ADD2"><block type="text" id="aev_s1c"><field name="TEXT"> odds → EVEN reversal → BUY DIGITEVEN ✅</field></block></value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <!-- Reset odd streak, increment even streak -->
                    <next>
                      <block type="variables_set" id="aev_rodd">
                        <field name="VAR" id="aev_codd">cons_odd</field>
                        <value name="VALUE"><block type="math_number" id="aev_rodd_v"><field name="NUM">0</field></block></value>
                        <next>
                          <block type="variables_set" id="aev_iev">
                            <field name="VAR" id="aev_cev">cons_even</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="aev_iev_add"><field name="OP">ADD</field>
                                <value name="A"><shadow type="math_number" id="aev_iev_as"><field name="NUM">1</field></shadow><block type="variables_get" id="aev_iev_ag"><field name="VAR" id="aev_cev">cons_even</field></block></value>
                                <value name="B"><shadow type="math_number" id="aev_iev_b"><field name="NUM">1</field></shadow></value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>

                <!-- ELSE — ODD digit: update counters, check signal 2 -->
                <statement name="ELSE">
                  <block type="variables_set" id="aev_rev">
                    <field name="VAR" id="aev_cev">cons_even</field>
                    <value name="VALUE"><block type="math_number" id="aev_rev_v"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="variables_set" id="aev_iodd">
                        <field name="VAR" id="aev_codd">cons_odd</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="aev_iodd_add"><field name="OP">ADD</field>
                            <value name="A"><shadow type="math_number" id="aev_iodd_as"><field name="NUM">1</field></shadow><block type="variables_get" id="aev_iodd_ag"><field name="VAR" id="aev_codd">cons_odd</field></block></value>
                            <value name="B"><shadow type="math_number" id="aev_iodd_b"><field name="NUM">1</field></shadow></value>
                          </block>
                        </value>
                        <next>
                          <!-- Signal 2: digit == entry_digit_1 OR entry_digit_2 (low odd %) -->
                          <block type="controls_if" id="aev_sig2">
                            <value name="IF0">
                              <block type="logic_operation" id="aev_sig2_or"><field name="OP">OR</field>
                                <value name="A">
                                  <block type="logic_compare" id="aev_sig2_e1"><field name="OP">EQ</field>
                                    <value name="A"><block type="variables_get" id="aev_sig2_a1"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                                    <value name="B"><block type="variables_get" id="aev_sig2_b1"><field name="VAR" id="aev_d1">entry_digit_1</field></block></value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="logic_compare" id="aev_sig2_e2"><field name="OP">EQ</field>
                                    <value name="A"><block type="variables_get" id="aev_sig2_a2"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                                    <value name="B"><block type="variables_get" id="aev_sig2_b2"><field name="VAR" id="aev_d2">entry_digit_2</field></block></value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set" id="aev_sig2_set">
                                <field name="VAR" id="aev_real">is_real_trade</field>
                                <value name="VALUE"><block type="math_number" id="aev_sig2_v"><field name="NUM">1</field></block></value>
                                <next>
                                  <block type="notify" id="aev_sig2_n">
                                    <field name="NOTIFICATION_TYPE">info</field>
                                    <field name="NOTIFICATION_SOUND">ding</field>
                                    <value name="MESSAGE">
                                      <block type="text_join" id="aev_sig2_nj"><mutation items="3"></mutation>
                                        <value name="ADD0"><block type="text" id="aev_s2a"><field name="TEXT">🎯 SIGNAL 2: Low odd digit </field></block></value>
                                        <value name="ADD1"><block type="variables_get" id="aev_s2b"><field name="VAR" id="aev_ld">last_digit</field></block></value>
                                        <value name="ADD2"><block type="text" id="aev_s2c"><field name="TEXT"> → BUY DIGITEVEN ✅</field></block></value>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>

                <!-- 4. Set stake: real trade → martingale_stake, scan → scan_stake -->
                <next>
                  <block type="controls_if" id="aev_setstk">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="aev_setstk_cmp"><field name="OP">EQ</field>
                        <value name="A"><block type="variables_get" id="aev_setstk_a"><field name="VAR" id="aev_real">is_real_trade</field></block></value>
                        <value name="B"><block type="math_number" id="aev_setstk_b"><field name="NUM">1</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <!-- Use martingale_stake for real trade -->
                      <block type="variables_set" id="aev_stk_real">
                        <field name="VAR" id="aev_stake">stake</field>
                        <value name="VALUE"><block type="variables_get" id="aev_stk_real_g"><field name="VAR" id="aev_ms">martingale_stake</field></block></value>
                        <next>
                          <block type="text_print" id="aev_stk_real_n">
                            <value name="TEXT">
                              <block type="text_join" id="aev_stk_real_nj"><mutation items="3"></mutation>
                                <value name="ADD0"><block type="text" id="aev_rta"><field name="TEXT">⚡ REAL TRADE — Stake: $</field></block></value>
                                <value name="ADD1"><block type="variables_get" id="aev_rtb"><field name="VAR" id="aev_ms">martingale_stake</field></block></value>
                                <value name="ADD2"><block type="text" id="aev_rtc"><field name="TEXT"> | Odd streak: </field></block></value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <!-- Use scan_stake for scan trade -->
                      <block type="variables_set" id="aev_stk_scan">
                        <field name="VAR" id="aev_stake">stake</field>
                        <value name="VALUE"><block type="variables_get" id="aev_stk_scan_g"><field name="VAR" id="aev_scan">scan_stake</field></block></value>
                      </block>
                    </statement>

                    <!-- 5. Purchase -->
                    <next>
                      <block type="purchase" id="aev_pur">
                        <field name="PURCHASE_LIST">DIGITEVEN</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>

            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- ═══ AFTER PURCHASE ════════════════════════════════════════════════ -->
  <block type="after_purchase" id="aev_ap" deletable="false" x="0" y="1100">
    <statement name="AFTERPURCHASE_STACK">

      <!-- Win / Loss handler -->
      <block type="controls_if" id="aev_ap_wl">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="aev_ap_win"><field name="CHECK_RESULT">win</field></block>
        </value>

        <!-- WIN -->
        <statement name="DO0">
          <!-- session_profit += martingale_stake (approximate) -->
          <block type="variables_set" id="aev_ap_w_pnl">
            <field name="VAR" id="aev_pnl">session_profit</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="aev_ap_w_pnl_add"><field name="OP">ADD</field>
                <value name="A"><shadow type="math_number" id="aev_ap_w_pnl_as"><field name="NUM">0</field></shadow><block type="variables_get" id="aev_ap_w_pnl_ag"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
                <value name="B"><shadow type="math_number" id="aev_ap_w_pnl_bs"><field name="NUM">1</field></shadow><block type="variables_get" id="aev_ap_w_pnl_bg"><field name="VAR" id="aev_ms">martingale_stake</field></block></value>
              </block>
            </value>
            <next>
              <!-- Reset martingale_stake to initial -->
              <block type="variables_set" id="aev_ap_w_rst">
                <field name="VAR" id="aev_ms">martingale_stake</field>
                <value name="VALUE"><block type="variables_get" id="aev_ap_w_rst_g"><field name="VAR" id="aev_init">initial_stake</field></block></value>
                <next>
                  <block type="notify" id="aev_ap_w_n">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">earned-money</field>
                    <value name="MESSAGE">
                      <block type="text_join" id="aev_ap_w_nj"><mutation items="3"></mutation>
                        <value name="ADD0"><block type="text" id="aev_ap_wa"><field name="TEXT">✅ WIN! Stake reset. Session P&amp;L: $</field></block></value>
                        <value name="ADD1"><block type="variables_get" id="aev_ap_wb"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
                        <value name="ADD2"><block type="text" id="aev_ap_wc"><field name="TEXT"> 🏆</field></block></value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <!-- LOSS -->
        <statement name="ELSE">
          <block type="controls_if" id="aev_ap_l_rt">
            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="aev_ap_l_cmp"><field name="OP">EQ</field>
                <value name="A"><block type="variables_get" id="aev_ap_l_a"><field name="VAR" id="aev_real">is_real_trade</field></block></value>
                <value name="B"><block type="math_number" id="aev_ap_l_b"><field name="NUM">1</field></block></value>
              </block>
            </value>
            <!-- Real trade loss: apply martingale -->
            <statement name="DO0">
              <block type="variables_set" id="aev_ap_l_pnl">
                <field name="VAR" id="aev_pnl">session_profit</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="aev_ap_l_pnl_sub"><field name="OP">MINUS</field>
                    <value name="A"><shadow type="math_number" id="aev_ap_l_pnl_as"><field name="NUM">0</field></shadow><block type="variables_get" id="aev_ap_l_pnl_ag"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
                    <value name="B"><shadow type="math_number" id="aev_ap_l_pnl_bs"><field name="NUM">1</field></shadow><block type="variables_get" id="aev_ap_l_pnl_bg"><field name="VAR" id="aev_ms">martingale_stake</field></block></value>
                  </block>
                </value>
                <next>
                  <!-- martingale_stake *= martingale -->
                  <block type="variables_set" id="aev_ap_l_mart">
                    <field name="VAR" id="aev_ms">martingale_stake</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="aev_ap_l_mart_mul"><field name="OP">MULTIPLY</field>
                        <value name="A"><shadow type="math_number" id="aev_ap_l_mart_as"><field name="NUM">1</field></shadow><block type="variables_get" id="aev_ap_l_mart_ag"><field name="VAR" id="aev_ms">martingale_stake</field></block></value>
                        <value name="B"><shadow type="math_number" id="aev_ap_l_mart_bs"><field name="NUM">2</field></shadow><block type="variables_get" id="aev_ap_l_mart_bg"><field name="VAR" id="aev_mart">martingale</field></block></value>
                      </block>
                    </value>
                    <next>
                      <block type="notify" id="aev_ap_l_n">
                        <field name="NOTIFICATION_TYPE">warning</field>
                        <field name="NOTIFICATION_SOUND">error</field>
                        <value name="MESSAGE">
                          <block type="text_join" id="aev_ap_l_nj"><mutation items="3"></mutation>
                            <value name="ADD0"><block type="text" id="aev_ap_la"><field name="TEXT">❌ LOSS — Martingale next: $</field></block></value>
                            <value name="ADD1"><block type="variables_get" id="aev_ap_lb"><field name="VAR" id="aev_ms">martingale_stake</field></block></value>
                            <value name="ADD2"><block type="text" id="aev_ap_lc"><field name="TEXT"> | Session: $</field></block></value>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <!-- Scan trade loss: no martingale -->
            <statement name="ELSE">
              <block type="text_print" id="aev_ap_scan_l">
                <value name="TEXT"><block type="text" id="aev_ap_scan_lt"><field name="TEXT">🔍 Scan trade — continuing scan...</field></block></value>
              </block>
            </statement>
          </block>
        </statement>
      </block>

      <!-- TP / SL check: only trade_again if limits not hit -->
      <next>
        <block type="controls_if" id="aev_ap_tpsl">
          <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
          <!-- TP hit? -->
          <value name="IF0">
            <block type="logic_compare" id="aev_ap_tp_cmp"><field name="OP">GTE</field>
              <value name="A"><block type="variables_get" id="aev_ap_tp_a"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
              <value name="B"><block type="variables_get" id="aev_ap_tp_b"><field name="VAR" id="aev_tp">take_profit</field></block></value>
            </block>
          </value>
          <statement name="DO0">
            <block type="notify" id="aev_tp_n">
              <field name="NOTIFICATION_TYPE">success</field>
              <field name="NOTIFICATION_SOUND">earned-money</field>
              <value name="MESSAGE">
                <block type="text_join" id="aev_tp_nj"><mutation items="3"></mutation>
                  <value name="ADD0"><block type="text" id="aev_tp_a"><field name="TEXT">🏁 TAKE PROFIT reached! Session: $</field></block></value>
                  <value name="ADD1"><block type="variables_get" id="aev_tp_b"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
                  <value name="ADD2"><block type="text" id="aev_tp_c"><field name="TEXT"> — Bot stopped ✅</field></block></value>
                </block>
              </value>
            </block>
          </statement>
          <!-- SL hit? -->
          <value name="IF1">
            <block type="logic_compare" id="aev_ap_sl_cmp"><field name="OP">LTE</field>
              <value name="A"><block type="variables_get" id="aev_ap_sl_a"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
              <value name="B">
                <block type="math_arithmetic" id="aev_ap_sl_neg"><field name="OP">MULTIPLY</field>
                  <value name="A"><block type="math_number" id="aev_ap_sl_neg_a"><field name="NUM">-1</field></block></value>
                  <value name="B"><block type="variables_get" id="aev_ap_sl_b"><field name="VAR" id="aev_sl">stop_loss</field></block></value>
                </block>
              </value>
            </block>
          </value>
          <statement name="DO1">
            <block type="notify" id="aev_sl_n">
              <field name="NOTIFICATION_TYPE">danger</field>
              <field name="NOTIFICATION_SOUND">error</field>
              <value name="MESSAGE">
                <block type="text_join" id="aev_sl_nj"><mutation items="3"></mutation>
                  <value name="ADD0"><block type="text" id="aev_sl_a"><field name="TEXT">🛑 STOP LOSS hit! Session: $</field></block></value>
                  <value name="ADD1"><block type="variables_get" id="aev_sl_b"><field name="VAR" id="aev_pnl">session_profit</field></block></value>
                  <value name="ADD2"><block type="text" id="aev_sl_c"><field name="TEXT"> — Bot stopped ❌</field></block></value>
                </block>
              </value>
            </block>
          </statement>
          <!-- Continue trading -->
          <statement name="ELSE">
            <block type="trade_again" id="aev_ta"></block>
          </statement>
        </block>
      </next>

    </statement>
  </block>

</xml>
