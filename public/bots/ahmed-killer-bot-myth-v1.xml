<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="akbm_stake">stake</variable>
    <variable id="akbm_base">base_stake</variable>
    <variable id="akbm_mg">martingale</variable>
    <variable id="akbm_phase">recovery_phase</variable>
    <variable id="akbm_tp">take_profit</variable>
    <variable id="akbm_sl">stop_loss</variable>
  </variables>
  <block type="trade_definition" id="akbm_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="king_fisher_best_market_scanner" id="akbm_scan">
        <field name="ENABLED">TRUE</field>
        <next>
          <block type="trade_definition_market" id="akbm_market" deletable="false" movable="false">
            <field name="MARKET_LIST">synthetic_index</field>
            <field name="SUBMARKET_LIST">random_index</field>
            <field name="SYMBOL_LIST">1HZ75V</field>
            <next>
              <block type="trade_definition_tradetype" id="akbm_type" deletable="false" movable="false">
                <field name="TRADETYPECAT_LIST">digits</field>
                <field name="TRADETYPE_LIST">overunder</field>
                <next>
                  <block type="trade_definition_contracttype" id="akbm_contract" deletable="false" movable="false">
                    <field name="TYPE_LIST">both</field>
                    <next>
                      <block type="trade_definition_candleinterval" id="akbm_interval" deletable="false" movable="false">
                        <field name="CANDLEINTERVAL_LIST">60</field>
                        <next>
                          <block type="trade_definition_restartbuysell" id="akbm_restart" deletable="false" movable="false">
                            <field name="TIME_MACHINE_ENABLED">FALSE</field>
                            <next>
                              <block type="trade_definition_restartonerror" id="akbm_error" deletable="false" movable="false">
                                <field name="RESTARTONERROR">TRUE</field>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="akbm_i_stake">
        <field name="VAR" id="akbm_stake">stake</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="akbm_i_base">
            <field name="VAR" id="akbm_base">base_stake</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="akbm_i_mg">
                <field name="VAR" id="akbm_mg">martingale</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">1.5</field></block></value>
                <next>
                  <block type="variables_set" id="akbm_i_phase">
                    <field name="VAR" id="akbm_phase">recovery_phase</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="variables_set" id="akbm_i_tp">
                        <field name="VAR" id="akbm_tp">take_profit</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value>
                        <next>
                          <block type="variables_set" id="akbm_i_sl">
                            <field name="VAR" id="akbm_sl">stop_loss</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">20</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="akbm_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT">
          <shadow type="math_number_positive"><field name="NUM">1</field></shadow>
          <block type="variables_get"><field name="VAR" id="akbm_stake">stake</field></block>
        </value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">2</field></shadow></value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="akbm_before" deletable="false" x="0" y="760">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify" id="akbm_note">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE"><block type="text"><field name="TEXT">AHMED KILLER BOT MYTH V1 · best market · 10/20 tick bias · 0.001s goal</field></block></value>
        <next>
          <block type="controls_if" id="akbm_phase_router">
            <mutation elseif="3"/>
            <value name="IF0">
              <block type="logic_compare"><field name="OP">EQ</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value>
                <value name="B"><block type="math_number"><field name="NUM">0</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="akbm_main_bias">
                <mutation else="1"/>
                <value name="IF0"><block type="king_fisher_bias_scan" id="akbm_bias_high"><field name="DIRECTION">HIGH</field><field name="WINDOW">10</field></block></value>
                <statement name="DO0"><block type="king_fisher_pair_purchase" id="akbm_over_pair"><field name="CONTRACT_1">DIGITOVER</field><field name="PREDICTION_1">2</field><field name="CONTRACT_2">DIGITOVER</field><field name="PREDICTION_2">3</field></block></statement>
                <statement name="ELSE"><block type="king_fisher_pair_purchase" id="akbm_under_pair"><field name="CONTRACT_1">DIGITUNDER</field><field name="PREDICTION_1">6</field><field name="CONTRACT_2">DIGITUNDER</field><field name="PREDICTION_2">7</field></block></statement>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare"><field name="OP">EQ</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value>
                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
              </block>
            </value>
            <statement name="DO1"><block type="king_fisher_pair_purchase" id="akbm_parity_pair"><field name="CONTRACT_1">DIGITEVEN</field><field name="PREDICTION_1">NONE</field><field name="CONTRACT_2">DIGITODD</field><field name="PREDICTION_2">NONE</field></block></statement>
            <value name="IF2">
              <block type="logic_compare"><field name="OP">EQ</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value>
                <value name="B"><block type="math_number"><field name="NUM">2</field></block></value>
              </block>
            </value>
            <statement name="DO2"><block type="king_fisher_pair_purchase" id="akbm_over3"><field name="CONTRACT_1">DIGITOVER</field><field name="PREDICTION_1">3</field><field name="CONTRACT_2">NONE</field><field name="PREDICTION_2">NONE</field></block></statement>
            <value name="IF3">
              <block type="logic_compare"><field name="OP">EQ</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value>
                <value name="B"><block type="math_number"><field name="NUM">3</field></block></value>
              </block>
            </value>
            <statement name="DO3"><block type="king_fisher_pair_purchase" id="akbm_over4"><field name="CONTRACT_1">DIGITOVER</field><field name="PREDICTION_1">4</field><field name="CONTRACT_2">NONE</field><field name="PREDICTION_2">NONE</field></block></statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="akbm_after" deletable="false" x="850" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="king_fisher_restart_trade" id="akbm_guard">
        <field name="MULTIPLIER">1.5</field>
        <value name="TAKE_PROFIT"><block type="variables_get"><field name="VAR" id="akbm_tp">take_profit</field></block></value>
        <value name="STOP_LOSS"><block type="variables_get"><field name="VAR" id="akbm_sl">stop_loss</field></block></value>
        <next>
          <block type="controls_if" id="akbm_result">
            <mutation else="1"/>
            <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">win</field></block></value>
            <statement name="DO0">
              <block type="variables_set" id="akbm_win_stake">
                <field name="VAR" id="akbm_stake">stake</field>
                <value name="VALUE"><block type="variables_get"><field name="VAR" id="akbm_base">base_stake</field></block></value>
                <next>
                  <block type="controls_if" id="akbm_win_phase_1">
                    <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                    <statement name="DO0"><block type="variables_set"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value></block></statement>
                    <statement name="ELSE">
                      <block type="controls_if" id="akbm_win_phase_2">
                        <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                        <statement name="DO0"><block type="variables_set"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">3</field></block></value></block></statement>
                        <statement name="ELSE">
                          <block type="controls_if" id="akbm_win_phase_3">
                            <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                            <statement name="DO0"><block type="variables_set"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
                          </block>
                        </statement>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="variables_set" id="akbm_loss_stake">
                <field name="VAR" id="akbm_stake">stake</field>
                <value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_stake">stake</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="akbm_mg">martingale</field></block></value></block></value>
                <next><block type="variables_set"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></next>
              </block>
            </statement>
            <next><block type="trade_again"/></next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>