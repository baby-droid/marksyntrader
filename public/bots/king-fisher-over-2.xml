<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="kf2_base">base stake</variable>
    <variable id="kf2_stake">stake</variable>
    <variable id="kf2_mg">martingale</variable>
    <variable id="kf2_tp">take profit</variable>
    <variable id="kf2_sl">stop loss</variable>
  </variables>
  <block type="trade_definition" id="kf2_trade" deletable="false" x="20" y="20">
    <statement name="TRADE_OPTIONS">
      <block type="king_fisher_best_market_scanner" id="kf2_best_market"><field name="ENABLED">TRUE</field><next>
      <block type="trade_definition_market" id="kf2_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="kf2_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="kf2_contract" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITOVER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="kf2_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="kf2_restart" deletable="false" movable="false"><field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next><block type="trade_definition_restartonerror" id="kf2_error" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
      </next></block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="kf2_set_base"><field name="VAR" id="kf2_base">base stake</field><value name="VALUE"><block type="math_number" id="kf2_base_num"><field name="NUM">1</field></block></value>
        <next><block type="variables_set" id="kf2_set_stake"><field name="VAR" id="kf2_stake">stake</field><value name="VALUE"><block type="variables_get" id="kf2_get_base"><field name="VAR" id="kf2_base">base stake</field></block></value>
          <next><block type="variables_set" id="kf2_set_mg"><field name="VAR" id="kf2_mg">martingale</field><value name="VALUE"><block type="math_number" id="kf2_mg_num"><field name="NUM">2</field></block></value>
            <next><block type="variables_set" id="kf2_set_tp"><field name="VAR" id="kf2_tp">take profit</field><value name="VALUE"><block type="math_number" id="kf2_tp_num"><field name="NUM">5</field></block></value>
              <next><block type="variables_set" id="kf2_set_sl"><field name="VAR" id="kf2_sl">stop loss</field><value name="VALUE"><block type="math_number" id="kf2_sl_num"><field name="NUM">20</field></block></value></block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="kf2_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive" id="kf2_duration"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT"><shadow type="math_number_positive" id="kf2_amount_shadow"><field name="NUM">1</field></shadow><block type="variables_get" id="kf2_amount"><field name="VAR" id="kf2_stake">stake</field></block></value>
        <value name="PREDICTION"><shadow type="math_number_positive" id="kf2_prediction_shadow"><field name="NUM">2</field></shadow><block type="math_number" id="kf2_prediction"><field name="NUM">2</field></block></value>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="kf2_after" x="760" y="20">
    <statement name="AFTERPURCHASE_STACK">
      <block type="king_fisher_restart_trade" id="kf2_guard"><value name="TAKE_PROFIT"><block type="variables_get" id="kf2_guard_tp"><field name="VAR" id="kf2_tp">take profit</field></block></value><value name="STOP_LOSS"><block type="variables_get" id="kf2_guard_sl"><field name="VAR" id="kf2_sl">stop loss</field></block></value><field name="MULTIPLIER">2</field><next><block type="controls_if" id="kf2_tp_if">
        <value name="IF0"><block type="logic_compare" id="kf2_tp_cmp"><field name="OP">GTE</field><value name="A"><block type="total_profit" id="kf2_profit"></block></value><value name="B"><block type="variables_get" id="kf2_tp_get"><field name="VAR" id="kf2_tp">take profit</field></block></value></block></value>
        <statement name="ELSE">
          <block type="controls_if" id="kf2_sl_if">
            <value name="IF0"><block type="logic_compare" id="kf2_sl_cmp"><field name="OP">LTE</field><value name="A"><block type="total_profit" id="kf2_loss"></block></value><value name="B"><block type="math_single" id="kf2_neg"><field name="OP">NEG</field><value name="NUM"><block type="variables_get" id="kf2_sl_get"><field name="VAR" id="kf2_sl">stop loss</field></block></value></block></value></block></value>
            <statement name="ELSE">
              <block type="controls_if" id="kf2_result">
                <value name="IF0"><block type="contract_check_result" id="kf2_win"><field name="CHECK_RESULT">win</field></block></value>
                <statement name="DO0"><block type="variables_set" id="kf2_reset"><field name="VAR" id="kf2_stake">stake</field><value name="VALUE"><block type="variables_get" id="kf2_reset_value"><field name="VAR" id="kf2_base">base stake</field></block></value></block></statement>
                <statement name="ELSE"><block type="variables_set" id="kf2_raise"><field name="VAR" id="kf2_stake">stake</field><value name="VALUE"><block type="math_arithmetic" id="kf2_multiply"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="kf2_stake_get"><field name="VAR" id="kf2_stake">stake</field></block></value><value name="B"><block type="variables_get" id="kf2_mg_get"><field name="VAR" id="kf2_mg">martingale</field></block></value></block></value></block></statement>
                <next><block type="trade_again" id="kf2_again"></block></next>
              </block>
            </statement>
          </block>
        </statement>
      </block></next></block>
    </statement>
  </block>
  <block type="before_purchase" id="kf2_before" x="20" y="900">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="kf2_gate">
        <value name="IF0"><block type="king_fisher_virtual_hook" id="kf2_hook"><field name="ENABLED">TRUE</field><field name="CONFIRMATIONS">1</field><field name="RESULT">LOSS</field><value name="SIGNAL"><block type="king_fisher_entry" id="kf2_hook_entry"><field name="DIRECTION">BELOW</field><field name="THRESHOLD">3</field><field name="STREAK">2_3</field></block></value></block></value>
        <statement name="DO0"><block type="purchase" id="kf2_buy"><field name="PURCHASE_LIST">DIGITOVER</field></block></statement>
      </block>
    </statement>
  </block>
</xml>