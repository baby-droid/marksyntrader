<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="accf_stake">stake</variable>
    <variable id="accf_base">base_stake</variable>
    <variable id="accf_martingale">martingale</variable>
    <variable id="accf_phase">cycle_phase</variable>
    <variable id="accf_tp">take_profit</variable>
    <variable id="accf_sl">stop_loss</variable>
    <variable id="accf_loss_count">parity_recovery_losses</variable>
  </variables>

  <block type="trade_definition" id="accf_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="king_fisher_best_market_scanner" id="accf_best_market">
        <field name="ENABLED">TRUE</field>
        <next><block type="trade_definition_market" id="accf_market" deletable="false" movable="false">
          <field name="MARKET_LIST">synthetic_index</field>
          <field name="SUBMARKET_LIST">random_index</field>
          <field name="SYMBOL_LIST">R_50</field><field name="ALTERNATE_MARKETS">TRUE</field>
          <next><block type="trade_definition_tradetype" id="accf_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next><block type="trade_definition_contracttype" id="accf_contract_type" deletable="false" movable="false">
              <field name="TYPE_LIST">both</field>
              <next><block type="trade_definition_candleinterval" id="accf_candle_interval" deletable="false" movable="false">
                <field name="CANDLEINTERVAL_LIST">60</field>
                <next><block type="trade_definition_restartbuysell" id="accf_restart_buy_sell" deletable="false" movable="false">
                  <field name="TIME_MACHINE_ENABLED">FALSE</field>
                  <next><block type="trade_definition_restartonerror" id="accf_restart_on_error" deletable="false" movable="false">
                    <field name="RESTARTONERROR">TRUE</field>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="accf_init_stake">
        <field name="VAR" id="accf_stake">stake</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">0.35</field></block></value>
        <next><block type="variables_set" id="accf_init_base">
          <field name="VAR" id="accf_base">base_stake</field>
          <value name="VALUE"><block type="math_number"><field name="NUM">0.35</field></block></value>
          <next><block type="variables_set" id="accf_init_martingale">
            <field name="VAR" id="accf_martingale">martingale</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
            <next><block type="variables_set" id="accf_init_phase">
              <field name="VAR" id="accf_phase">cycle_phase</field>
              <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
              <next><block type="variables_set" id="accf_init_tp">
                <field name="VAR" id="accf_tp">take_profit</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value>
                <next><block type="variables_set" id="accf_init_sl">
                  <field name="VAR" id="accf_sl">stop_loss</field>
                  <value name="VALUE"><block type="math_number"><field name="NUM">15</field></block></value>
                  <next><block type="variables_set" id="accf_init_loss_count"><field name="VAR" id="accf_loss_count">parity_recovery_losses</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="accf_trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT">
          <shadow type="math_number_positive"><field name="NUM">0.35</field></shadow>
          <block type="variables_get"><field name="VAR" id="accf_stake">stake</field></block>
        </value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="accf_before" deletable="false" x="0" y="760">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify" id="accf_scan_message">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE"><block type="text"><field name="TEXT">ACC FLIPPER · 10-tick bias + 2–3 tick barrier confirmation · parity recovery unlocks two Over 3 wins</field></block></value>
        <next><block type="controls_if" id="accf_phase_router"><mutation elseif="5"/>
          <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
          <statement name="DO0"><block type="controls_if" id="accf_over1_gate">
            <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
              <value name="A"><block type="king_fisher_chart_ai_phase_gate" id="accf_over1_bias"><field name="DIRECTION">HIGH</field><field name="BARRIER">1</field></block></value>
              <value name="B"><block type="king_fisher_entry" id="accf_over1_entry"><field name="DIRECTION">ABOVE</field><field name="THRESHOLD">1</field><field name="STREAK">2_3</field></block></value>
            </block></value>
            <statement name="DO0"><block type="multiple_purchase" id="accf_over1_purchase">
              <field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
              <field name="PREDICTION">1</field>
            </block></statement>
          </block></statement>
          <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
          <statement name="DO1"><block type="controls_if" id="accf_over2_gate">
            <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
              <value name="A"><block type="king_fisher_chart_ai_phase_gate" id="accf_over2_bias"><field name="DIRECTION">HIGH</field><field name="BARRIER">2</field></block></value>
              <value name="B"><block type="king_fisher_entry" id="accf_over2_entry"><field name="DIRECTION">ABOVE</field><field name="THRESHOLD">2</field><field name="STREAK">2_3</field></block></value>
            </block></value>
            <statement name="DO0"><block type="multiple_purchase" id="accf_over2_purchase">
              <field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
              <field name="PREDICTION">2</field>
            </block></statement>
          </block></statement>
          <value name="IF2"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
          <statement name="DO2"><block type="controls_if" id="accf_under8_gate">
            <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
              <value name="A"><block type="king_fisher_chart_ai_phase_gate" id="accf_under8_bias"><field name="DIRECTION">LOW</field><field name="BARRIER">8</field></block></value>
              <value name="B"><block type="king_fisher_entry" id="accf_under8_entry"><field name="DIRECTION">BELOW</field><field name="THRESHOLD">8</field><field name="STREAK">2_3</field></block></value>
            </block></value>
            <statement name="DO0"><block type="multiple_purchase" id="accf_under8_purchase">
              <field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
              <field name="PREDICTION">8</field>
            </block></statement>
          </block></statement>
          <value name="IF3"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
          <statement name="DO3"><block type="controls_if" id="accf_under7_gate">
            <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
              <value name="A"><block type="king_fisher_chart_ai_phase_gate" id="accf_under7_bias"><field name="DIRECTION">LOW</field><field name="BARRIER">7</field></block></value>
              <value name="B"><block type="king_fisher_entry" id="accf_under7_entry"><field name="DIRECTION">BELOW</field><field name="THRESHOLD">7</field><field name="STREAK">2_3</field></block></value>
            </block></value>
            <statement name="DO0"><block type="multiple_purchase" id="accf_under7_purchase">
              <field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
              <field name="PREDICTION">7</field>
            </block></statement>
          </block></statement>
          <value name="IF4"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
          <statement name="DO4"><block type="controls_if" id="accf_recovery_over3_first_gate">
            <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
              <value name="A"><block type="king_fisher_chart_ai_phase_gate" id="accf_recovery_over3_first_bias"><field name="DIRECTION">HIGH</field><field name="BARRIER">3</field></block></value>
              <value name="B"><block type="king_fisher_entry" id="accf_recovery_over3_first_entry"><field name="DIRECTION">ABOVE</field><field name="THRESHOLD">3</field><field name="STREAK">2_3</field></block></value>
            </block></value>
            <statement name="DO0"><block type="multiple_purchase" id="accf_recovery_over3_first">
              <field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
              <field name="PREDICTION">3</field>
            </block></statement>
          </block></statement>
          <value name="IF5"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
          <statement name="DO5"><block type="controls_if" id="accf_recovery_over3_second_gate">
            <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
              <value name="A"><block type="king_fisher_chart_ai_phase_gate" id="accf_recovery_over3_second_bias"><field name="DIRECTION">HIGH</field><field name="BARRIER">3</field></block></value>
              <value name="B"><block type="king_fisher_entry" id="accf_recovery_over3_second_entry"><field name="DIRECTION">ABOVE</field><field name="THRESHOLD">3</field><field name="STREAK">2_3</field></block></value>
            </block></value>
            <statement name="DO0"><block type="multiple_purchase" id="accf_recovery_over3_second">
              <field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
              <field name="PREDICTION">3</field>
            </block></statement>
          </block></statement>
          <statement name="ELSE"><block type="king_fisher_parity_sequence_purchase" id="accf_parity_recovery"/></statement>
        </block></next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="accf_after" deletable="false" x="850" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="king_fisher_restart_trade" id="accf_risk_guard">
        <field name="MULTIPLIER">2</field>
        <value name="TAKE_PROFIT"><block type="variables_get"><field name="VAR" id="accf_tp">take_profit</field></block></value>
        <value name="STOP_LOSS"><block type="variables_get"><field name="VAR" id="accf_sl">stop_loss</field></block></value>
        <next><block type="king_fisher_recovery_escalation" id="accf_recovery_escalation">
          <field name="PHASE" id="accf_phase">cycle_phase</field>
          <field name="LOSS_COUNT" id="accf_loss_count">parity_recovery_losses</field>
          <field name="RECOVERY_PHASE">6</field><field name="FIRST_OVER3_PHASE">4</field><field name="SECOND_OVER3_PHASE">5</field>
          <next><block type="controls_if" id="accf_result"><mutation else="1"/>
          <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">win</field></block></value>
          <statement name="DO0"><block type="variables_set" id="accf_reset_stake_on_win">
            <field name="VAR" id="accf_stake">stake</field>
            <value name="VALUE"><block type="variables_get"><field name="VAR" id="accf_base">base_stake</field></block></value>
            <next><block type="controls_if" id="accf_advance_cycle"><mutation elseif="5"/>
              <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
              <statement name="DO0"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
              <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
              <statement name="DO1"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value></block></statement>
              <value name="IF2"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
              <statement name="DO2"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">3</field></block></value></block></statement>
              <value name="IF3"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
              <statement name="DO3"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
              <value name="IF4"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
              <statement name="DO4"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value></block></statement>
              <value name="IF5"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
              <statement name="DO5"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">6</field></block></value></block></statement>
              <statement name="ELSE"><block type="variables_set"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
            </block></next>
          </block></statement>
          <statement name="ELSE"><block type="controls_if" id="accf_loss_stake_cap"><mutation else="1"/>
            <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_stake">stake</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
            <statement name="DO0"><block type="variables_set" id="accf_cap_stake"><field name="VAR" id="accf_stake">stake</field><value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value></block></statement>
            <statement name="ELSE"><block type="variables_set" id="accf_multiply_stake"><field name="VAR" id="accf_stake">stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="accf_stake">stake</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="accf_martingale">martingale</field></block></value></block></value></block></statement>
            <next><block type="variables_set" id="accf_loss_to_recovery"><field name="VAR" id="accf_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">6</field></block></value></block></next>
          </block></statement>
          <next><block type="trade_again"/></next>
        </block></next>
        </block></next>
      </block>
    </statement>
  </block>
</xml>