<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="adc_stake">stake</variable>
    <variable id="adc_initial">initial_stake</variable>
    <variable id="adc_martingale">martingale</variable>
    <variable id="adc_phase">cycle_phase</variable>
    <variable id="adc_digit">last_digit</variable>
  </variables>

  <block type="trade_definition" id="adc_trade_definition" deletable="false" x="0" y="60">
    <data>gt.seq.tradeDef</data>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="adc_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="adc_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="adc_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="adc_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="adc_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="adc_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="adc_set_stake">
        <field name="VAR" id="adc_stake">stake</field>
        <value name="VALUE"><block type="math_number" id="adc_stake_value"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="adc_set_initial">
            <field name="VAR" id="adc_initial">initial_stake</field>
            <value name="VALUE"><block type="math_number" id="adc_initial_value"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="adc_set_martingale">
                <field name="VAR" id="adc_martingale">martingale</field>
                <value name="VALUE"><block type="math_number" id="adc_martingale_value"><field name="NUM">2.1</field></block></value>
                <next>
                  <block type="variables_set" id="adc_set_phase">
                    <field name="VAR" id="adc_phase">cycle_phase</field>
                    <value name="VALUE"><block type="math_number" id="adc_phase_value"><field name="NUM">0</field></block></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="adc_before_purchase" deletable="false" x="0" y="900">
    <data>gt.seq.beforePurchase</data>
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="adc_capture_digit">
        <field name="VAR" id="adc_digit">last_digit</field>
        <value name="VALUE"><block type="last_digit" id="adc_last_digit"/></value>
        <next>
          <block type="controls_if" id="adc_sequence_controller">
            <data>gt.seq.applySequence</data>
            <mutation elseif="2" else="1"/>
            <value name="IF0">
              <block type="logic_compare" id="adc_phase_0_test">
                <field name="OP">EQ</field>
                <value name="A"><block type="variables_get" id="adc_phase_0_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value>
                <value name="B"><block type="math_number" id="adc_phase_0_value"><field name="NUM">0</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="multiple_purchase" id="adc_purchase_differs">
                <field name="PURCHASE_1">DIGITDIFF</field>
                <field name="PURCHASE_2"/>
                <field name="PURCHASE_3"/>
                <field name="PURCHASE_4"/>
                <field name="PURCHASE_5"/>
                <field name="PURCHASE_6"/>
                <field name="PREDICTION">LAST_DIGIT</field>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="adc_phase_1_test">
                <field name="OP">EQ</field>
                <value name="A"><block type="variables_get" id="adc_phase_1_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value>
                <value name="B"><block type="math_number" id="adc_phase_1_value"><field name="NUM">1</field></block></value>
              </block>
            </value>
            <statement name="DO1">
              <block type="multiple_purchase" id="adc_purchase_over1">
                <field name="PURCHASE_1">DIGITOVER</field>
                <field name="PURCHASE_2"/>
                <field name="PURCHASE_3"/>
                <field name="PURCHASE_4"/>
                <field name="PURCHASE_5"/>
                <field name="PURCHASE_6"/>
                <field name="PREDICTION">1</field>
              </block>
            </statement>
            <value name="IF2">
              <block type="logic_compare" id="adc_phase_2_test">
                <field name="OP">EQ</field>
                <value name="A"><block type="variables_get" id="adc_phase_2_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value>
                <value name="B"><block type="math_number" id="adc_phase_2_value"><field name="NUM">2</field></block></value>
              </block>
            </value>
            <statement name="DO2">
              <block type="multiple_purchase" id="adc_purchase_over2">
                <field name="PURCHASE_1">DIGITOVER</field>
                <field name="PURCHASE_2"/>
                <field name="PURCHASE_3"/>
                <field name="PURCHASE_4"/>
                <field name="PURCHASE_5"/>
                <field name="PURCHASE_6"/>
                <field name="PREDICTION">2</field>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="controls_if" id="adc_parity_controller">
                <mutation else="1"/>
                <value name="IF0">
                  <block type="logic_compare" id="adc_even_test">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="math_modulo" id="adc_even_modulo">
                        <value name="DIVIDEND"><block type="variables_get" id="adc_even_digit"><field name="VAR" id="adc_digit">last_digit</field></block></value>
                        <value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value>
                      </block>
                    </value>
                    <value name="B"><block type="math_number" id="adc_even_zero"><field name="NUM">0</field></block></value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="multiple_purchase" id="adc_purchase_even">
                    <field name="PURCHASE_1">DIGITEVEN</field>
                    <field name="PURCHASE_2"/>
                    <field name="PURCHASE_3"/>
                    <field name="PURCHASE_4"/>
                    <field name="PURCHASE_5"/>
                    <field name="PURCHASE_6"/>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="multiple_purchase" id="adc_purchase_odd">
                    <field name="PURCHASE_1">DIGITODD</field>
                    <field name="PURCHASE_2"/>
                    <field name="PURCHASE_3"/>
                    <field name="PURCHASE_4"/>
                    <field name="PURCHASE_5"/>
                    <field name="PURCHASE_6"/>
                  </block>
                </statement>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="adc_after_purchase" deletable="false" x="900" y="900">
    <data>gt.seq.afterPurchase</data>
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="adc_result_router">
        <mutation else="1"/>
        <value name="IF0"><block type="contract_check_result" id="adc_win_check"><field name="CHECK_RESULT">win</field></block></value>
        <statement name="DO0">
          <block type="variables_set" id="adc_reset_stake">
            <field name="VAR" id="adc_stake">stake</field>
            <value name="VALUE"><block type="variables_get" id="adc_initial_stake"><field name="VAR" id="adc_initial">initial_stake</field></block></value>
            <next>
              <block type="controls_if" id="adc_win_phase_router">
                <mutation else="1"/>
                <value name="IF0">
                  <block type="logic_compare" id="adc_win_phase_test">
                    <field name="OP">LT</field>
                    <value name="A"><block type="variables_get" id="adc_win_phase"><field name="VAR" id="adc_phase">cycle_phase</field></block></value>
                    <value name="B"><block type="math_number" id="adc_last_main_phase"><field name="NUM">2</field></block></value>
                  </block>
                </value>
                <statement name="DO0"><block type="math_change" id="adc_advance_phase"><field name="VAR" id="adc_phase">cycle_phase</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement>
                <statement name="ELSE"><block type="variables_set" id="adc_restart_cycle"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number" id="adc_restart_cycle_value"><field name="NUM">0</field></block></value></block></statement>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="adc_martingale_stake">
            <field name="VAR" id="adc_stake">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="adc_stake_multiply">
                <field name="OP">MULTIPLY</field>
                <value name="A"><block type="variables_get" id="adc_current_stake"><field name="VAR" id="adc_stake">stake</field></block></value>
                <value name="B"><block type="variables_get" id="adc_martingale_value_get"><field name="VAR" id="adc_martingale">martingale</field></block></value>
              </block>
            </value>
            <next>
              <block type="controls_if" id="adc_loss_parity_router">
                <mutation else="1"/>
                <value name="IF0">
                  <block type="logic_compare" id="adc_loss_even_test">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="math_modulo" id="adc_loss_modulo">
                        <value name="DIVIDEND"><block type="variables_get" id="adc_loss_digit"><field name="VAR" id="adc_digit">last_digit</field></block></value>
                        <value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value>
                      </block>
                    </value>
                    <value name="B"><block type="math_number" id="adc_loss_zero"><field name="NUM">0</field></block></value>
                  </block>
                </value>
                <statement name="DO0"><block type="variables_set" id="adc_even_recovery_phase"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number" id="adc_even_recovery_value"><field name="NUM">3</field></block></value></block></statement>
                <statement name="ELSE"><block type="variables_set" id="adc_odd_recovery_phase"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number" id="adc_odd_recovery_value"><field name="NUM">4</field></block></value></block></statement>
              </block>
            </next>
          </block>
        </statement>
        <next><block type="trade_again" id="adc_trade_again"/></next>
      </block>
    </statement>
  </block>
</xml>