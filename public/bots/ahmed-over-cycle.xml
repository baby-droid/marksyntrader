<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="aoc_stake">stake</variable>
    <variable id="aoc_initial">initial_stake</variable>
    <variable id="aoc_martingale">martingale</variable>
    <variable id="aoc_phase">cycle_phase</variable>
    <variable id="aoc_recovery">recovery_mode</variable>
    <variable id="aoc_digit">last_digit</variable>
    <variable id="aoc_prev_parity">previous_parity</variable>
    <variable id="aoc_parity_streak">parity_streak</variable>
    <variable id="aoc_prev_direction">previous_direction</variable>
    <variable id="aoc_direction_streak">direction_streak</variable>
  </variables>

  <!--
    AHMED OVER CYCLE
    DIFFERS 0 → OVER 1 → OVER 2 → OVER 3 → three-tick directional reversal
    → DIFFERS 9 → UNDER 8 → UNDER 7 → UNDER 6 → directional reversal.
    Three or more rises buy FALL; three or more falls buy RISE. Losses wait for four evens or
    four odds and buy the matching parity contract before resuming the cycle.
  -->
  <block type="trade_definition" id="aoc_trade_definition" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="aoc_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="aoc_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">risefall</field>
            <next>
              <block type="trade_definition_contracttype" id="aoc_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="aoc_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="aoc_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="aoc_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="aoc_init_stake">
        <field name="VAR" id="aoc_stake">stake</field>
        <value name="VALUE"><block type="math_number" id="aoc_stake_value"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="aoc_init_initial">
            <field name="VAR" id="aoc_initial">initial_stake</field>
            <value name="VALUE"><block type="math_number" id="aoc_initial_value"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="aoc_init_martingale">
                <field name="VAR" id="aoc_martingale">martingale</field>
                <value name="VALUE"><block type="math_number" id="aoc_martingale_value"><field name="NUM">2.1</field></block></value>
                <next>
                  <block type="variables_set" id="aoc_init_phase">
                    <field name="VAR" id="aoc_phase">cycle_phase</field>
                    <value name="VALUE"><block type="math_number" id="aoc_phase_value"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="variables_set" id="aoc_init_recovery">
                        <field name="VAR" id="aoc_recovery">recovery_mode</field>
                        <value name="VALUE"><block type="math_number" id="aoc_recovery_value"><field name="NUM">0</field></block></value>
                        <next>
                          <block type="variables_set" id="aoc_init_prev_parity">
                            <field name="VAR" id="aoc_prev_parity">previous_parity</field>
                            <value name="VALUE"><block type="math_number" id="aoc_prev_parity_value"><field name="NUM">-1</field></block></value>
                            <next>
                              <block type="variables_set" id="aoc_init_parity_streak">
                                <field name="VAR" id="aoc_parity_streak">parity_streak</field>
                                <value name="VALUE"><block type="math_number" id="aoc_parity_streak_value"><field name="NUM">0</field></block></value>
                                <next>
                                  <block type="variables_set" id="aoc_init_prev_direction">
                                    <field name="VAR" id="aoc_prev_direction">previous_direction</field>
                                    <value name="VALUE"><block type="math_number" id="aoc_prev_direction_value"><field name="NUM">0</field></block></value>
                                    <next>
                                      <block type="variables_set" id="aoc_init_direction_streak">
                                        <field name="VAR" id="aoc_direction_streak">direction_streak</field>
                                        <value name="VALUE"><block type="math_number" id="aoc_direction_streak_value"><field name="NUM">0</field></block></value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
       <block type="trade_definition_tradeoptions" id="aoc_trade_options" deletable="false" movable="false">
         <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT"><shadow type="math_number_positive"><field name="NUM">1</field></shadow><block type="variables_get" id="aoc_amount"><field name="VAR" id="aoc_stake">stake</field></block></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="aoc_before_purchase" deletable="false" x="0" y="900">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="aoc_capture_digit">
        <field name="VAR" id="aoc_digit">last_digit</field>
        <value name="VALUE"><block type="last_digit" id="aoc_last_digit"/></value>
        <next>
          <block type="controls_if" id="aoc_update_parity">
            <mutation else="1"/>
            <value name="IF0"><block type="logic_compare" id="aoc_same_parity"><field name="OP">EQ</field><value name="A"><block type="math_modulo" id="aoc_current_mod"><value name="DIVIDEND"><block type="variables_get" id="aoc_current_digit"><field name="VAR" id="aoc_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value><value name="B"><block type="variables_get" id="aoc_previous_parity"><field name="VAR" id="aoc_prev_parity">previous_parity</field></block></value></block></value>
            <statement name="DO0"><block type="math_change" id="aoc_inc_parity"><field name="VAR" id="aoc_parity_streak">parity_streak</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement>
            <statement name="ELSE"><block type="variables_set" id="aoc_reset_parity"><field name="VAR" id="aoc_parity_streak">parity_streak</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
            <next>
              <block type="variables_set" id="aoc_store_parity">
                <field name="VAR" id="aoc_prev_parity">previous_parity</field>
                <value name="VALUE"><block type="math_modulo" id="aoc_store_mod"><value name="DIVIDEND"><block type="variables_get" id="aoc_store_digit"><field name="VAR" id="aoc_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value>
                <next>
                  <block type="controls_if" id="aoc_update_direction">
                    <mutation else="1"/>
                    <value name="IF0"><block type="check_direction" id="aoc_check_rise"><field name="CHECK_DIRECTION">rise</field></block></value>
                    <statement name="DO0">
                      <block type="controls_if" id="aoc_same_rise">
                        <mutation else="1"/>
                        <value name="IF0"><block type="logic_compare" id="aoc_rise_streak_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_rise_previous"><field name="VAR" id="aoc_prev_direction">previous_direction</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                        <statement name="DO0"><block type="math_change" id="aoc_rise_inc"><field name="VAR" id="aoc_direction_streak">direction_streak</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement>
                        <statement name="ELSE"><block type="variables_set" id="aoc_rise_reset"><field name="VAR" id="aoc_direction_streak">direction_streak</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
                        <next><block type="variables_set" id="aoc_mark_rise"><field name="VAR" id="aoc_prev_direction">previous_direction</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></next>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="controls_if" id="aoc_check_fall">
                        <mutation else="1"/>
                        <value name="IF0"><block type="check_direction" id="aoc_check_fall_block"><field name="CHECK_DIRECTION">fall</field></block></value>
                        <statement name="DO0"><block type="controls_if" id="aoc_same_fall"><mutation else="1"/><value name="IF0"><block type="logic_compare" id="aoc_fall_streak_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_prev_direction_get"><field name="VAR" id="aoc_prev_direction">previous_direction</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value><statement name="DO0"><block type="math_change" id="aoc_fall_inc"><field name="VAR" id="aoc_direction_streak">direction_streak</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement><statement name="ELSE"><block type="variables_set" id="aoc_fall_reset"><field name="VAR" id="aoc_direction_streak">direction_streak</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement><next><block type="variables_set" id="aoc_mark_fall"><field name="VAR" id="aoc_prev_direction">previous_direction</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value></block></next></block></statement>
                        <statement name="ELSE"><block type="variables_set" id="aoc_clear_direction"><field name="VAR" id="aoc_prev_direction">previous_direction</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set" id="aoc_clear_direction_streak"><field name="VAR" id="aoc_direction_streak">direction_streak</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></next></block></statement>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="aoc_recovery_or_cycle">
                        <mutation else="1"/>
                        <value name="IF0"><block type="logic_compare" id="aoc_recovery_active"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_recovery_get"><field name="VAR" id="aoc_recovery">recovery_mode</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                        <statement name="DO0">
                          <block type="controls_if" id="aoc_recovery_ready">
                            <value name="IF0"><block type="logic_compare" id="aoc_four_parity"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="aoc_streak_get"><field name="VAR" id="aoc_parity_streak">parity_streak</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
                            <statement name="DO0">
                              <block type="controls_if" id="aoc_even_or_odd">
                                <mutation else="1"/>
                                <value name="IF0"><block type="logic_compare" id="aoc_even_digit"><field name="OP">EQ</field><value name="A"><block type="math_modulo" id="aoc_recovery_mod"><value name="DIVIDEND"><block type="variables_get" id="aoc_recovery_digit"><field name="VAR" id="aoc_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                                 <statement name="DO0"><block type="variables_set" id="aoc_clear_even"><field name="VAR" id="aoc_recovery">recovery_mode</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set" id="aoc_recovery_phase_even"><field name="VAR" id="aoc_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">9</field></block></value><next><block type="multiple_purchase" id="aoc_buy_even"><field name="PURCHASE_1">DIGITEVEN</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">NONE</field></block></next></block></next></block></statement>
                                 <statement name="ELSE"><block type="variables_set" id="aoc_clear_odd"><field name="VAR" id="aoc_recovery">recovery_mode</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_set" id="aoc_recovery_phase_odd"><field name="VAR" id="aoc_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">9</field></block></value><next><block type="multiple_purchase" id="aoc_buy_odd"><field name="PURCHASE_1">DIGITODD</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PREDICTION">NONE</field></block></next></block></next></block></statement>
                              </block>
                            </statement>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="controls_if" id="aoc_cycle_router">
                            <mutation elseif="9"/>
                            <value name="IF0"><block type="logic_compare" id="aoc_phase0"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase0_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                            <statement name="DO0"><block type="multiple_purchase" id="aoc_buy_differs0"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">0</field></block></statement>
                            <value name="IF1"><block type="logic_compare" id="aoc_phase1"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase1_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                            <statement name="DO1"><block type="multiple_purchase" id="aoc_buy_over1"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">1</field></block></statement>
                            <value name="IF2"><block type="logic_compare" id="aoc_phase2"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase2_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                            <statement name="DO2"><block type="multiple_purchase" id="aoc_buy_over2"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">2</field></block></statement>
                            <value name="IF3"><block type="logic_compare" id="aoc_phase3"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase3_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                            <statement name="DO3"><block type="multiple_purchase" id="aoc_buy_over3"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
                            <value name="IF4"><block type="logic_compare" id="aoc_phase4"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase4_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
                            <statement name="DO4"><block type="controls_if" id="aoc_direction_ready_1"><value name="IF0"><block type="logic_compare" id="aoc_two_direction_1"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="aoc_direction_streak_1"><field name="VAR" id="aoc_direction_streak">direction_streak</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value><statement name="DO0"><block type="controls_if" id="aoc_contrarian_1"><mutation else="1"/><value name="IF0"><block type="logic_compare" id="aoc_rise_test_1"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_direction_1"><field name="VAR" id="aoc_prev_direction">previous_direction</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value><statement name="DO0"><block type="purchase" id="aoc_buy_fall_1"><field name="PURCHASE_LIST">PUT</field></block></statement><statement name="ELSE"><block type="purchase" id="aoc_buy_rise_1"><field name="PURCHASE_LIST">CALL</field></block></statement></block></statement></block></statement>
                            <value name="IF5"><block type="logic_compare" id="aoc_phase5"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase5_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
                            <statement name="DO5"><block type="multiple_purchase" id="aoc_buy_differs9"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">9</field></block></statement>
                            <value name="IF6"><block type="logic_compare" id="aoc_phase6"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase6_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
                            <statement name="DO6"><block type="multiple_purchase" id="aoc_buy_under8"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">8</field></block></statement>
                            <value name="IF7"><block type="logic_compare" id="aoc_phase7"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase7_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">7</field></block></value></block></value>
                            <statement name="DO7"><block type="multiple_purchase" id="aoc_buy_under7"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">7</field></block></statement>
                            <value name="IF8"><block type="logic_compare" id="aoc_phase8"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase8_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">8</field></block></value></block></value>
                            <statement name="DO8"><block type="multiple_purchase" id="aoc_buy_under6"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">6</field></block></statement>
                            <value name="IF9"><block type="logic_compare" id="aoc_phase9"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_phase9_get"><field name="VAR" id="aoc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">9</field></block></value></block></value>
                            <statement name="DO9"><block type="controls_if" id="aoc_direction_ready_2"><value name="IF0"><block type="logic_compare" id="aoc_two_direction_2"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="aoc_direction_streak_2"><field name="VAR" id="aoc_direction_streak">direction_streak</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value><statement name="DO0"><block type="controls_if" id="aoc_contrarian_2"><mutation else="1"/><value name="IF0"><block type="logic_compare" id="aoc_rise_test_2"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="aoc_direction_2"><field name="VAR" id="aoc_prev_direction">previous_direction</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value><statement name="DO0"><block type="purchase" id="aoc_buy_fall_2"><field name="PURCHASE_LIST">PUT</field></block></statement><statement name="ELSE"><block type="purchase" id="aoc_buy_rise_2"><field name="PURCHASE_LIST">CALL</field></block></statement></block></statement></block></statement>
                          </block>
                    </statement>
                  </block>
                </next>
              </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="aoc_after_purchase" deletable="false" x="900" y="900">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="aoc_result_router">
        <mutation else="1"/>
        <value name="IF0"><block type="contract_check_result" id="aoc_win_check"><field name="CHECK_RESULT">win</field></block></value>
        <statement name="DO0">
