<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="adoc2_stake">stake</variable>
    <variable id="adoc2_base">base_stake</variable>
    <variable id="adoc2_mg">martingale</variable>
    <variable id="adoc2_tp">take_profit</variable>
    <variable id="adoc2_sl">stop_loss</variable>
  </variables>
  <block type="trade_definition" id="adoc2_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="adoc2_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>
        <next>
          <block type="trade_definition_tradetype" id="adoc2_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="adoc2_contract" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="adoc2_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="adoc2_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="adoc2_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="adoc2_i_stake">
        <field name="VAR" id="adoc2_stake">stake</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="adoc2_i_base">
            <field name="VAR" id="adoc2_base">base_stake</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="adoc2_i_mg">
                <field name="VAR" id="adoc2_mg">martingale</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">2.2</field></block></value>
                <next>
                  <block type="variables_set" id="adoc2_i_tp">
                    <field name="VAR" id="adoc2_tp">take_profit</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value>
                    <next>
                      <block type="variables_set" id="adoc2_i_sl">
                        <field name="VAR" id="adoc2_sl">stop_loss</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">20</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="adoc2_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT"><shadow type="math_number_positive"><field name="NUM">1</field></shadow><block type="variables_get"><field name="VAR" id="adoc2_stake">stake</field></block></value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">3</field></shadow></value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="adoc2_before" deletable="false" x="0" y="760">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify" id="adoc2_note">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE"><block type="text"><field name="TEXT">AHMED DIFFER RECOVERY V2 · parity recovery scan</field></block></value>
        <next>
          <block type="controls_if" id="adoc2_router">
            <mutation else="1"/>
            <value name="IF0"><block type="king_fisher_entry" id="adoc2_entry"><field name="DIRECTION">BELOW</field><field name="THRESHOLD">5</field><field name="STREAK">2_3</field></block></value>
            <statement name="DO0"><block type="multiple_purchase"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2">DIGITOVER</field><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">2</field></block></statement>
            <statement name="ELSE"><block type="multiple_purchase"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2">DIGITODD</field><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">7</field></block></statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="adoc2_after" deletable="false" x="850" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="king_fisher_restart_trade" id="adoc2_guard">
        <field name="MULTIPLIER">2</field>
        <value name="TAKE_PROFIT"><block type="variables_get"><field name="VAR" id="adoc2_tp">take_profit</field></block></value>
        <value name="STOP_LOSS"><block type="variables_get"><field name="VAR" id="adoc2_sl">stop_loss</field></block></value>
        <next>
          <block type="controls_if" id="adoc2_result">
            <mutation else="1"/>
            <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">win</field></block></value>
            <statement name="DO0"><block type="variables_set"><field name="VAR" id="adoc2_stake">stake</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="adoc2_base">base_stake</field></block></value></block></statement>
            <statement name="ELSE"><block type="variables_set"><field name="VAR" id="adoc2_stake">stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="adoc2_stake">stake</field></block></value><value name="B"><block type="variables_get"><field name="VAR" id="adoc2_mg">martingale</field></block></value></block></value></block></statement>
            <next><block type="trade_again"/></next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>