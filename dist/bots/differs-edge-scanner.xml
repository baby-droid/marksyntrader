<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="des_stake">stake</variable>
    <variable id="des_initial">initial_stake</variable>
    <variable id="des_martingale">martingale</variable>
    <variable id="des_phase">phase</variable>
    <variable id="des_digit">last_digit</variable>
  </variables>

  <!--
    DIFFERS EDGE SCANNER
    Main rotation: Differs → Over 2 → Over 3 → Differs → Under 7 → Under 6.
    A loss multiplies the stake and routes to parity recovery:
    an even loss buys Odd; an odd loss buys Even. A recovery win resets the
    six-phase cycle to Differs. No parity-state blocks are required.
    Every contract is one tick and every result continues with trade_again.
  -->
  <block type="trade_definition" id="des_definition" deletable="false" x="0" y="60">
    <data>gt.seq.tradeDef</data>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="des_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="des_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="des_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="des_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="des_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="des_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="des_set_stake">
        <field name="VAR" id="des_stake">stake</field>
        <value name="VALUE"><block type="math_number" id="des_stake_value"><field name="NUM">0.5</field></block></value>
        <next>
          <block type="variables_set" id="des_set_initial">
            <field name="VAR" id="des_initial">initial_stake</field>
            <value name="VALUE"><block type="math_number" id="des_initial_value"><field name="NUM">0.5</field></block></value>
            <next>
              <block type="variables_set" id="des_set_martingale">
                <field name="VAR" id="des_martingale">martingale</field>
                <value name="VALUE"><block type="math_number" id="des_martingale_value"><field name="NUM">2</field></block></value>
                <next>
                      <block type="variables_set" id="des_set_phase">
                        <field name="VAR" id="des_phase">phase</field>
                        <value name="VALUE"><block type="math_number" id="des_phase_value"><field name="NUM">0</field></block></value>
                      </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="des_trade_options" deletable="false" movable="false">
        <data>gt.seq.tradeoptions</data>
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT"><shadow type="math_number_positive"><field name="NUM">0.5</field></shadow><block type="variables_get" id="des_current_stake"><field name="VAR" id="des_stake">stake</field></block></value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">2</field></shadow></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="des_before_purchase" deletable="false" x="0" y="900">
    <data>gt.seq.beforePurchase</data>
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="des_capture_digit">
        <field name="VAR" id="des_digit">last_digit</field>
        <value name="VALUE"><block type="last_digit" id="des_last_digit"/></value>
        <next>
          <block type="controls_if" id="des_phase_router">
                    <mutation elseif="7"/>
                    <value name="IF0"><block type="logic_compare" id="des_phase0_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase0_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                    <statement name="DO0"><block type="multiple_purchase" id="des_buy_differs_a"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">LAST_DIGIT</field></block></statement>
                    <value name="IF1"><block type="logic_compare" id="des_phase1_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase1_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                    <statement name="DO1"><block type="multiple_purchase" id="des_buy_over2"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">2</field></block></statement>
                    <value name="IF2"><block type="logic_compare" id="des_phase2_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase2_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                    <statement name="DO2"><block type="multiple_purchase" id="des_buy_over3"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
                    <value name="IF3"><block type="logic_compare" id="des_phase3_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase3_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                    <statement name="DO3"><block type="multiple_purchase" id="des_buy_differs_b"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">LAST_DIGIT</field></block></statement>
                    <value name="IF4"><block type="logic_compare" id="des_phase4_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase4_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
                    <statement name="DO4"><block type="multiple_purchase" id="des_buy_under7"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">7</field></block></statement>
                    <value name="IF5"><block type="logic_compare" id="des_phase5_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase5_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
                    <statement name="DO5"><block type="multiple_purchase" id="des_buy_under6"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">6</field></block></statement>
                    <value name="IF6"><block type="logic_compare" id="des_phase6_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase6_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
                    <statement name="DO6"><block type="multiple_purchase" id="des_buy_odd_recovery"><field name="PURCHASE_1">DIGITODD</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/></block></statement>
                    <value name="IF7"><block type="logic_compare" id="des_phase7_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="des_phase7_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">7</field></block></value></block></value>
                    <statement name="DO7"><block type="multiple_purchase" id="des_buy_even_recovery"><field name="PURCHASE_1">DIGITEVEN</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/></block></statement>
                  </block>
                </next>
              </block>
    </statement>
  </block>

  <block type="after_purchase" id="des_after_purchase" deletable="false" x="900" y="900">
    <data>gt.seq.afterPurchase</data>
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="des_result_router">
        <mutation else="1"/>
        <value name="IF0"><block type="contract_check_result" id="des_win_check"><field name="CHECK_RESULT">win</field></block></value>
        <statement name="DO0">
          <block type="variables_set" id="des_reset_stake">
            <field name="VAR" id="des_stake">stake</field>
            <value name="VALUE"><block type="variables_get" id="des_initial_stake"><field name="VAR" id="des_initial">initial_stake</field></block></value>
            <next>
              <block type="controls_if" id="des_win_phase_router">
                <mutation else="1"/>
                <value name="IF0"><block type="logic_compare" id="des_last_main_phase"><field name="OP">LT</field><value name="A"><block type="variables_get" id="des_phase_get"><field name="VAR" id="des_phase">phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
                <statement name="DO0"><block type="math_change" id="des_advance_phase"><field name="VAR" id="des_phase">phase</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement>
                <statement name="ELSE"><block type="variables_set" id="des_restart_phase"><field name="VAR" id="des_phase">phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="des_loss_stake">
            <field name="VAR" id="des_stake">stake</field>
            <value name="VALUE"><block type="math_arithmetic" id="des_multiply_stake"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="des_current_stake_after_loss"><field name="VAR" id="des_stake">stake</field></block></value><value name="B"><block type="variables_get" id="des_martingale_get"><field name="VAR" id="des_martingale">martingale</field></block></value></block></value>
            <next>
              <block type="controls_if" id="des_recovery_router">
                <mutation else="1"/>
                <value name="IF0"><block type="logic_compare" id="des_even_loss_test"><field name="OP">EQ</field><value name="A"><block type="math_modulo" id="des_loss_modulo"><value name="DIVIDEND"><block type="variables_get" id="des_loss_digit"><field name="VAR" id="des_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                <statement name="DO0"><block type="variables_set" id="des_even_to_odd"><field name="VAR" id="des_phase">phase</field><value name="VALUE"><block type="math_number" id="des_even_to_odd_phase"><field name="NUM">6</field></block></value></block></statement>
                <statement name="ELSE"><block type="variables_set" id="des_odd_to_even"><field name="VAR" id="des_phase">phase</field><value name="VALUE"><block type="math_number" id="des_odd_to_even_phase"><field name="NUM">7</field></block></value></block></statement>
              </block>
            </next>
          </block>
        </statement>
        <next><block type="trade_again" id="des_trade_again"/></next>
      </block>
    </statement>
  </block>
</xml>