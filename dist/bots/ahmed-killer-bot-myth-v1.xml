<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="akbm_stake">stake</variable>
    <variable id="akbm_base">base_stake</variable>
    <variable id="akbm_mg">martingale</variable>
    <variable id="akbm_phase">recovery_phase</variable>
    <variable id="akbm_tp">take_profit</variable>
    <variable id="akbm_sl">stop_loss</variable>
    <variable id="akbm_loss_count">parity_recovery_losses</variable>
  </variables>
  <block type="trade_definition" id="akbm_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="king_fisher_best_market_scanner" id="akbm_scan"><field name="ENABLED">TRUE</field>
        <next><block type="trade_definition_market" id="akbm_market" deletable="false" movable="false">
          <field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">1HZ75V</field><field name="ALTERNATE_MARKETS">TRUE</field>
          <next><block type="trade_definition_tradetype" id="akbm_type" deletable="false" movable="false"><field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">overunder</field>
            <next><block type="trade_definition_contracttype" id="akbm_contract" deletable="false" movable="false"><field name="TYPE_LIST">both</field>
              <next><block type="trade_definition_candleinterval" id="akbm_interval" deletable="false" movable="false"><field name="CANDLEINTERVAL_LIST">60</field>
                <next><block type="trade_definition_restartbuysell" id="akbm_restart" deletable="false" movable="false"><field name="TIME_MACHINE_ENABLED">FALSE</field>
                  <next><block type="trade_definition_restartonerror" id="akbm_error" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="akbm_i_stake"><field name="VAR" id="akbm_stake">stake</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
        <next><block type="variables_set" id="akbm_i_base"><field name="VAR" id="akbm_base">base_stake</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
          <next><block type="variables_set" id="akbm_i_mg"><field name="VAR" id="akbm_mg">martingale</field><value name="VALUE"><block type="math_number"><field name="NUM">1.5</field></block></value>
            <next><block type="variables_set" id="akbm_i_phase"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
              <next><block type="variables_set" id="akbm_i_tp"><field name="VAR" id="akbm_tp">take_profit</field><value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value>
                <next><block type="variables_set" id="akbm_i_sl"><field name="VAR" id="akbm_sl">stop_loss</field><value name="VALUE"><block type="math_number"><field name="NUM">20</field></block></value>
                  <next><block type="variables_set" id="akbm_i_loss_count"><field name="VAR" id="akbm_loss_count">parity_recovery_losses</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="akbm_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT"><shadow type="math_number_positive"><field name="NUM">1</field></shadow><block type="variables_get"><field name="VAR" id="akbm_stake">stake</field></block></value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="akbm_before" deletable="false" x="0" y="760">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify" id="akbm_note"><field name="NOTIFICATION_TYPE">info</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text"><field name="TEXT">AHMED KILLER BOT MYTH V1 · best-market scan · waiting for 10/20-tick Over 1 + Over 2 bias</field></block></value>
        <next><block type="controls_if" id="akbm_phase_router"><mutation elseif="10"/>
          <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
          <statement name="DO0">
            <block type="controls_if" id="akbm_bias_10"><mutation else="1"/>
              <value name="IF0"><block type="king_fisher_bias_scan" id="akbm_bias_high_10"><field name="DIRECTION">HIGH</field><field name="WINDOW">10</field></block></value>
              <statement name="DO0"><block type="king_fisher_pair_purchase" id="akbm_over_pair_10"><field name="CONTRACT_1">DIGITOVER</field><field name="PREDICTION_1">1</field><field name="CONTRACT_2">DIGITOVER</field><field name="PREDICTION_2">2</field></block></statement>
              <statement name="ELSE">
                <block type="controls_if" id="akbm_bias_20"><mutation else="1"/>
                  <value name="IF0"><block type="king_fisher_bias_scan" id="akbm_bias_high_20"><field name="DIRECTION">HIGH</field><field name="WINDOW">20</field></block></value>
                  <statement name="DO0"><block type="king_fisher_pair_purchase" id="akbm_over_pair_20"><field name="CONTRACT_1">DIGITOVER</field><field name="PREDICTION_1">1</field><field name="CONTRACT_2">DIGITOVER</field><field name="PREDICTION_2">2</field></block></statement>
                  <statement name="ELSE"><block type="notify" id="akbm_wait_bias"><field name="NOTIFICATION_TYPE">info</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><block type="text"><field name="TEXT">KILLER MYTH · bias not met · waiting for the next live tick</field></block></value></block></statement>
                </block>
              </statement>
            </block>
          </statement>
          <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
          <statement name="DO1"><block type="king_fisher_parity_sequence_purchase" id="akbm_parity_recovery"/></statement>
          <value name="IF2"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
          <statement name="DO2"><block type="multiple_purchase" id="akbm_over3"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
          <value name="IF3"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
          <statement name="DO3"><block type="multiple_purchase" id="akbm_over3_run2"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
          <value name="IF4"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
          <statement name="DO4"><block type="multiple_purchase" id="akbm_over3_run3"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
          <value name="IF5"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
          <statement name="DO5"><block type="multiple_purchase" id="akbm_over4_run1"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">4</field></block></statement>
          <value name="IF6"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
          <statement name="DO6"><block type="multiple_purchase" id="akbm_over4_run2"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">4</field></block></statement>
          <value name="IF7"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">7</field></block></value></block></value>
          <statement name="DO7"><block type="controls_if" id="akbm_fall_after_rises_gate">
            <value name="IF0"><block type="king_fisher_price_entry" id="akbm_fall_after_rises"><field name="DIRECTION">FALL_AFTER_RISES</field><field name="STREAK">4</field></block></value>
            <statement name="DO0"><block type="purchase" id="akbm_fall_after_rises_purchase"><field name="PURCHASE_LIST">PUT</field></block></statement>
          </block></statement>
          <value name="IF8"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">8</field></block></value></block></value>
          <statement name="DO8"><block type="controls_if" id="akbm_rise_after_falls_gate">
            <value name="IF0"><block type="king_fisher_price_entry" id="akbm_rise_after_falls"><field name="DIRECTION">RISE_AFTER_FALLS</field><field name="STREAK">2_3</field></block></value>
            <statement name="DO0"><block type="purchase" id="akbm_rise_after_falls_purchase"><field name="PURCHASE_LIST">CALL</field></block></statement>
          </block></statement>
          <value name="IF9"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">9</field></block></value></block></value>
          <statement name="DO9"><block type="multiple_purchase" id="akbm_recovery_over3_first"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
          <value name="IF10"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
          <statement name="DO10"><block type="multiple_purchase" id="akbm_recovery_over3_second"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">3</field></block></statement>
        </block></next>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="akbm_after" deletable="false" x="850" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="king_fisher_restart_trade" id="akbm_guard"><field name="MULTIPLIER">1.5</field><value name="TAKE_PROFIT"><block type="variables_get"><field name="VAR" id="akbm_tp">take_profit</field></block></value><value name="STOP_LOSS"><block type="variables_get"><field name="VAR" id="akbm_sl">stop_loss</field></block></value>
        <next><block type="king_fisher_recovery_escalation" id="akbm_recovery_escalation">
          <field name="PHASE" id="akbm_phase">recovery_phase</field>
          <field name="LOSS_COUNT" id="akbm_loss_count">parity_recovery_losses</field>
          <field name="RECOVERY_PHASE">1</field><field name="INTERMEDIATE_PHASE_1">7</field><field name="INTERMEDIATE_PHASE_2">8</field><field name="FIRST_OVER3_PHASE">9</field><field name="SECOND_OVER3_PHASE">10</field><field name="RETURN_PHASE">1</field>
          <next><block type="controls_if" id="akbm_result"><mutation else="1"/>
          <value name="IF0"><block type="contract_check_result"><field name="CHECK_RESULT">win</field></block></value>
          <statement name="DO0"><block type="variables_set" id="akbm_win_stake"><field name="VAR" id="akbm_stake">stake</field><value name="VALUE"><block type="variables_get"><field name="VAR" id="akbm_base">base_stake</field></block></value>
            <next><block type="controls_if" id="akbm_win_phase_0"><mutation elseif="8"/>
              <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
              <statement name="DO0"><block type="variables_set" id="akbm_pair_to_over3"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value></block></statement>
              <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
              <statement name="DO1"><block type="variables_set" id="akbm_recovery_to_over3"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value></block></statement>
              <value name="IF2"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
              <statement name="DO2"><block type="variables_set" id="akbm_over3_to_run2"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">3</field></block></value></block></statement>
              <value name="IF3"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
              <statement name="DO3"><block type="variables_set" id="akbm_over3_to_run3"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">4</field></block></value></block></statement>
              <value name="IF4"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
              <statement name="DO4"><block type="variables_set" id="akbm_over3_to_over4"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value></block></statement>
              <value name="IF5"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
              <statement name="DO5"><block type="variables_set" id="akbm_over4_to_run2"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">6</field></block></value></block></statement>
              <value name="IF6"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
              <statement name="DO6"><block type="variables_set" id="akbm_over4_to_pair"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
              <value name="IF7"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">9</field></block></value></block></value>
              <statement name="DO7"><block type="variables_set" id="akbm_recovery_over3_first_win"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value></block></statement>
              <value name="IF8"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
              <statement name="DO8"><block type="variables_set" id="akbm_recovery_over3_second_win"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
            </block></next>
          </block></statement>
          <statement name="ELSE"><block type="variables_set" id="akbm_loss_stake"><field name="VAR" id="akbm_stake">stake</field><value name="VALUE"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get"><field name="VAR" id="akbm_stake">stake</field></block></value><value name="B"><block type="variables_get" id="akbm_mg_get"><field name="VAR" id="akbm_mg">martingale</field></block></value></block></value>
            <next><block type="variables_set" id="akbm_loss_phase"><field name="VAR" id="akbm_phase">recovery_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></next>
          </block></statement>
          <next><block type="trade_again"/></next>
        </block></next>
        </block></next>
      </block>
    </statement>
  </block>
</xml>