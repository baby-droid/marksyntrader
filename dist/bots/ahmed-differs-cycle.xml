<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="adc_stake">stake</variable>
    <variable id="adc_initial">initial_stake</variable>
    <variable id="adc_martingale">martingale</variable>
    <variable id="adc_phase">cycle_phase</variable>
    <variable id="adc_digit">last_digit</variable>
    <variable id="adc_previous_parity">previous_parity</variable>
    <variable id="adc_parity_streak">parity_streak</variable>
  </variables>

  <!--
    AHMED DIFFERS CYCLE
    Normal cycle: DIGITDIFF → DIGITOVER 1 → DIGITOVER 2 → DIGITDIFF →
    DIGITUNDER 8 → DIGITUNDER 7 → DIGITDIFF.
    Recovery gate: after three evens, buy DIGITODD; after three odds, buy
    DIGITEVEN. A mixed parity sequence returns to Differs.
    One-tick contracts, 2.1x recovery, and continuous trade_again flow.
  -->
  <block type="trade_definition" id="adc_trade_definition" deletable="false" x="0" y="60">
    <data>gt.seq.tradeDef</data>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="adc_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="adc_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="adc_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="adc_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="adc_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="adc_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="adc_set_stake">
        <field name="VAR" id="adc_stake">stake</field>
        <value name="VALUE"><block type="math_number" id="adc_stake_value"><field name="NUM">1</field></block></value>
        <next>
          <block type="variables_set" id="adc_set_initial">
            <field name="VAR" id="adc_initial">initial_stake</field>
            <value name="VALUE"><block type="math_number" id="adc_initial_value"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="adc_set_martingale">
                <field name="VAR" id="adc_martingale">martingale</field>
                <value name="VALUE"><block type="math_number" id="adc_martingale_value"><field name="NUM">2.1</field></block></value>
                <next>
                  <block type="variables_set" id="adc_set_phase">
                    <field name="VAR" id="adc_phase">cycle_phase</field>
                    <value name="VALUE"><block type="math_number" id="adc_phase_value"><field name="NUM">0</field></block></value>
                    <next>
                      <block type="variables_set" id="adc_set_previous_parity">
                        <field name="VAR" id="adc_previous_parity">previous_parity</field>
                        <value name="VALUE"><block type="math_number" id="adc_previous_parity_value"><field name="NUM">-1</field></block></value>
                        <next>
                          <block type="variables_set" id="adc_set_parity_streak">
                            <field name="VAR" id="adc_parity_streak">parity_streak</field>
                            <value name="VALUE"><block type="math_number" id="adc_parity_streak_value"><field name="NUM">0</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="adc_trade_options" deletable="false" movable="false">
        <data>gt.seq.tradeoptions</data>
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT"><shadow type="math_number_positive"><field name="NUM">1</field></shadow><block type="variables_get" id="adc_current_stake_option"><field name="VAR" id="adc_stake">stake</field></block></value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="adc_before_purchase" deletable="false" x="0" y="900">
    <data>gt.seq.beforePurchase</data>
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="adc_capture_digit">
        <field name="VAR" id="adc_digit">last_digit</field>
        <value name="VALUE"><block type="last_digit" id="adc_last_digit"/></value>
        <next>
          <block type="controls_if" id="adc_update_parity_streak">
            <mutation else="1"/>
            <value name="IF0">
              <block type="logic_compare" id="adc_same_parity">
                <field name="OP">EQ</field>
                <value name="A"><block type="math_modulo" id="adc_current_modulo"><value name="DIVIDEND"><block type="variables_get" id="adc_current_digit"><field name="VAR" id="adc_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value>
                <value name="B"><block type="variables_get" id="adc_previous_parity_get"><field name="VAR" id="adc_previous_parity">previous_parity</field></block></value>
              </block>
            </value>
            <statement name="DO0"><block type="math_change" id="adc_parity_streak_inc"><field name="VAR" id="adc_parity_streak">parity_streak</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement>
            <statement name="ELSE"><block type="variables_set" id="adc_parity_streak_reset"><field name="VAR" id="adc_parity_streak">parity_streak</field><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
            <next>
              <block type="variables_set" id="adc_store_previous_parity">
                <field name="VAR" id="adc_previous_parity">previous_parity</field>
                <value name="VALUE"><block type="math_modulo" id="adc_store_parity_modulo"><value name="DIVIDEND"><block type="variables_get" id="adc_store_digit"><field name="VAR" id="adc_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value>
                <next>
                  <block type="controls_if" id="adc_sequence_controller">
                    <data>gt.seq.applySequence</data>
                    <mutation elseif="8" else="1"/>
                    <value name="IF0"><block type="logic_compare" id="adc_phase_differs_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_differs_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                    <statement name="DO0"><block type="multiple_purchase" id="adc_purchase_differs"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">LAST_DIGIT</field></block></statement>
                    <value name="IF1"><block type="logic_compare" id="adc_phase_odd_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_odd_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                    <statement name="DO1"><block type="multiple_purchase" id="adc_purchase_over1"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">1</field></block></statement>
                    <value name="IF2"><block type="logic_compare" id="adc_phase_even_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_even_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                    <statement name="DO2"><block type="multiple_purchase" id="adc_purchase_over2"><field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">2</field></block></statement>
                     <value name="IF3"><block type="logic_compare" id="adc_phase_differs_middle_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_differs_middle_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                     <statement name="DO3"><block type="multiple_purchase" id="adc_purchase_differs_middle"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">LAST_DIGIT</field></block></statement>
                     <value name="IF4"><block type="logic_compare" id="adc_phase_under8_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_under8_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
                     <statement name="DO4"><block type="multiple_purchase" id="adc_purchase_under8"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">8</field></block></statement>
                     <value name="IF5"><block type="logic_compare" id="adc_phase_under7_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_under7_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
                     <statement name="DO5"><block type="multiple_purchase" id="adc_purchase_under7"><field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">7</field></block></statement>
                     <value name="IF6"><block type="logic_compare" id="adc_phase_differs_final_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_differs_final_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
                     <statement name="DO6"><block type="multiple_purchase" id="adc_purchase_differs_final"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">LAST_DIGIT</field></block></statement>
                     <value name="IF7"><block type="logic_compare" id="adc_phase_odd_recovery_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_odd_recovery_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">7</field></block></value></block></value>
                     <statement name="DO7"><block type="multiple_purchase" id="adc_purchase_odd"><field name="PURCHASE_1">DIGITODD</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/></block></statement>
                     <value name="IF8"><block type="logic_compare" id="adc_phase_even_recovery_test"><field name="OP">EQ</field><value name="A"><block type="variables_get" id="adc_phase_even_recovery_get"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">8</field></block></value></block></value>
                     <statement name="DO8"><block type="multiple_purchase" id="adc_purchase_even"><field name="PURCHASE_1">DIGITEVEN</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/></block></statement>
                    <statement name="ELSE"><block type="multiple_purchase" id="adc_fallback_differs"><field name="PURCHASE_1">DIGITDIFF</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/><field name="PREDICTION">LAST_DIGIT</field></block></statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="adc_after_purchase" deletable="false" x="900" y="900">
    <data>gt.seq.afterPurchase</data>
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="adc_result_router">
        <mutation else="1"/>
        <value name="IF0"><block type="contract_check_result" id="adc_win_check"><field name="CHECK_RESULT">win</field></block></value>
        <statement name="DO0">
          <block type="variables_set" id="adc_reset_stake"><field name="VAR" id="adc_stake">stake</field><value name="VALUE"><block type="variables_get" id="adc_initial_stake"><field name="VAR" id="adc_initial">initial_stake</field></block></value><next><block type="controls_if" id="adc_win_phase_router"><mutation else="1"/><value name="IF0"><block type="logic_compare" id="adc_main_phase_test"><field name="OP">LT</field><value name="A"><block type="variables_get" id="adc_phase_after_win"><field name="VAR" id="adc_phase">cycle_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value><statement name="DO0"><block type="math_change" id="adc_advance_phase"><field name="VAR" id="adc_phase">cycle_phase</field><value name="DELTA"><shadow type="math_number"><field name="NUM">1</field></shadow></value></block></statement><statement name="ELSE"><block type="variables_set" id="adc_restart_phase"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement></block></next></block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="adc_martingale_stake">
            <field name="VAR" id="adc_stake">stake</field>
            <value name="VALUE"><block type="math_arithmetic" id="adc_stake_multiply"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="adc_current_stake"><field name="VAR" id="adc_stake">stake</field></block></value><value name="B"><block type="variables_get" id="adc_martingale_value_get"><field name="VAR" id="adc_martingale">martingale</field></block></value></block></value>
            <next>
              <block type="controls_if" id="adc_loss_streak_gate">
                <mutation else="1"/>
                <value name="IF0"><block type="logic_compare" id="adc_three_same_parity"><field name="OP">GTE</field><value name="A"><block type="variables_get" id="adc_streak_value"><field name="VAR" id="adc_parity_streak">parity_streak</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                <statement name="DO0">
                  <block type="controls_if" id="adc_contrarian_parity">
                    <mutation else="1"/>
                    <value name="IF0"><block type="logic_compare" id="adc_loss_even_test"><field name="OP">EQ</field><value name="A"><block type="math_modulo" id="adc_loss_modulo"><value name="DIVIDEND"><block type="variables_get" id="adc_loss_digit"><field name="VAR" id="adc_digit">last_digit</field></block></value><value name="DIVISOR"><shadow type="math_number"><field name="NUM">2</field></shadow></value></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                    <statement name="DO0"><block type="variables_set" id="adc_even_to_odd"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">7</field></block></value></block></statement>
                    <statement name="ELSE"><block type="variables_set" id="adc_odd_to_even"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">8</field></block></value></block></statement>
                  </block>
                </statement>
                <statement name="ELSE"><block type="variables_set" id="adc_no_streak_differs"><field name="VAR" id="adc_phase">cycle_phase</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
              </block>
            </next>
          </block>
        </statement>
        <next><block type="trade_again" id="adc_trade_again"/></next>
      </block>
    </statement>
  </block>
</xml>