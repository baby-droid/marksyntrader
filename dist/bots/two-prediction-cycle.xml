<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="tp2_stake">stake</variable>
    <variable id="tp2_over1_base_stake">over_1_base_stake</variable>
    <variable id="tp2_over1_stake">over_1_stake</variable>
    <variable id="tp2_over2_base_stake">over_2_base_stake</variable>
    <variable id="tp2_over2_stake">over_2_stake</variable>
    <variable id="tp2_under8_base_stake">under_8_base_stake</variable>
    <variable id="tp2_under8_stake">under_8_stake</variable>
    <variable id="tp2_under7_base_stake">under_7_base_stake</variable>
    <variable id="tp2_under7_stake">under_7_stake</variable>
    <variable id="tp2_martingale">martingale</variable>
    <variable id="tp2_phase">recovery_phase</variable>
    <variable id="tp2_loss_count">paired_loss_count</variable>
    <variable id="tp2_tp">take_profit</variable>
    <variable id="tp2_sl">stop_loss</variable>
  </variables>

  <block type="trade_definition" id="tp2_definition" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="king_fisher_best_market_scanner" id="tp2_scanner">
        <field name="ENABLED">TRUE</field>
        <next><block type="trade_definition_market" id="tp2_market" deletable="false" movable="false">
          <field name="MARKET_LIST">synthetic_index</field>
          <field name="SUBMARKET_LIST">random_index</field>
          <field name="SYMBOL_LIST">R_50</field>
          <field name="ALTERNATE_MARKETS">TRUE</field>
          <next><block type="trade_definition_tradetype" id="tp2_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next><block type="trade_definition_contracttype" id="tp2_contract_type" deletable="false" movable="false">
              <field name="TYPE_LIST">both</field>
              <next><block type="trade_definition_candleinterval" id="tp2_candle_interval" deletable="false" movable="false">
                <field name="CANDLEINTERVAL_LIST">60</field>
                <next><block type="trade_definition_restartbuysell" id="tp2_restart_buy_sell" deletable="false" movable="false">
                  <field name="TIME_MACHINE_ENABLED">FALSE</field>
                  <next><block type="trade_definition_restartonerror" id="tp2_restart_error" deletable="false" movable="false">
                    <field name="RESTARTONERROR">TRUE</field>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="tp2_init_stake">
        <field name="VAR" id="tp2_stake">stake</field>
        <value name="VALUE"><block type="math_number"><field name="NUM">0.5</field></block></value>
        <next><block type="variables_set" id="tp2_init_over1_base_stake">
          <field name="VAR" id="tp2_over1_base_stake">over_1_base_stake</field>
          <value name="VALUE"><block type="math_number"><field name="NUM">0.5</field></block></value>
          <next><block type="variables_set" id="tp2_init_over1_stake">
            <field name="VAR" id="tp2_over1_stake">over_1_stake</field>
            <value name="VALUE"><block type="variables_get"><field name="VAR" id="tp2_over1_base_stake">over_1_base_stake</field></block></value>
            <next><block type="variables_set" id="tp2_init_over2_base_stake">
              <field name="VAR" id="tp2_over2_base_stake">over_2_base_stake</field>
              <value name="VALUE"><block type="math_number"><field name="NUM">0.5</field></block></value>
              <next><block type="variables_set" id="tp2_init_over2_stake">
                <field name="VAR" id="tp2_over2_stake">over_2_stake</field>
                <value name="VALUE"><block type="variables_get"><field name="VAR" id="tp2_over2_base_stake">over_2_base_stake</field></block></value>
                <next><block type="variables_set" id="tp2_init_under8_base_stake">
                  <field name="VAR" id="tp2_under8_base_stake">under_8_base_stake</field>
                  <value name="VALUE"><block type="math_number"><field name="NUM">0.5</field></block></value>
                  <next><block type="variables_set" id="tp2_init_under8_stake">
                    <field name="VAR" id="tp2_under8_stake">under_8_stake</field>
                    <value name="VALUE"><block type="variables_get"><field name="VAR" id="tp2_under8_base_stake">under_8_base_stake</field></block></value>
                    <next><block type="variables_set" id="tp2_init_under7_base_stake">
                      <field name="VAR" id="tp2_under7_base_stake">under_7_base_stake</field>
                      <value name="VALUE"><block type="math_number"><field name="NUM">0.5</field></block></value>
                      <next><block type="variables_set" id="tp2_init_under7_stake">
                        <field name="VAR" id="tp2_under7_stake">under_7_stake</field>
                        <value name="VALUE"><block type="variables_get"><field name="VAR" id="tp2_under7_base_stake">under_7_base_stake</field></block></value>
                        <next><block type="variables_set" id="tp2_init_martingale">
                          <field name="VAR" id="tp2_martingale">martingale</field>
                          <value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
                          <next><block type="variables_set" id="tp2_init_phase">
                            <field name="VAR" id="tp2_phase">recovery_phase</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                            <next><block type="variables_set" id="tp2_init_loss_count">
                              <field name="VAR" id="tp2_loss_count">paired_loss_count</field>
                              <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                              <next><block type="variables_set" id="tp2_init_tp">
                                <field name="VAR" id="tp2_tp">take_profit</field>
                                <value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value>
                                <next><block type="variables_set" id="tp2_init_sl">
                                  <field name="VAR" id="tp2_sl">stop_loss</field>
                                  <value name="VALUE"><block type="math_number"><field name="NUM">20</field></block></value>
                                </block></next>
                              </block></next>
                            </block></next>
                          </block></next>
                        </block></next>
                      </block></next>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tp2_trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"/>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
        <value name="AMOUNT">
          <shadow type="math_number_positive"><field name="NUM">0.5</field></shadow>
          <block type="variables_get"><field name="VAR" id="tp2_stake">stake</field></block>
        </value>
        <value name="PREDICTION"><shadow type="math_number_positive"><field name="NUM">1</field></shadow></value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="tp2_before" deletable="false" x="0" y="760">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="notify" id="tp2_note">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE"><block type="text"><field name="TEXT">2 PREDICTION · Over 1 + Over 2 / Under 8 + Under 7 · paired net-result recovery · editable martingale</field></block></value>
        <next><block type="controls_if" id="tp2_phase_router"><mutation elseif="5"/>
          <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
          <statement name="DO0"><block type="king_fisher_pair_purchase_with_stakes" id="tp2_over_pair">
            <field name="CONTRACT_1">DIGITOVER</field><field name="PREDICTION_1">1</field>
            <field name="CONTRACT_2">DIGITOVER</field><field name="PREDICTION_2">2</field>
            <value name="STAKE_1"><block type="variables_get"><field name="VAR" id="tp2_over1_stake">over_1_stake</field></block></value>
            <value name="STAKE_2"><block type="variables_get"><field name="VAR" id="tp2_over2_stake">over_2_stake</field></block></value>
          </block></statement>
          <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
          <statement name="DO1"><block type="king_fisher_pair_purchase_with_stakes" id="tp2_under_pair">
            <field name="CONTRACT_1">DIGITUNDER</field><field name="PREDICTION_1">8</field>
            <field name="CONTRACT_2">DIGITUNDER</field><field name="PREDICTION_2">7</field>
            <value name="STAKE_1"><block type="variables_get"><field name="VAR" id="tp2_under8_stake">under_8_stake</field></block></value>
            <value name="STAKE_2"><block type="variables_get"><field name="VAR" id="tp2_under7_stake">under_7_stake</field></block></value>
          </block></statement>
          <value name="IF2"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
          <statement name="DO2"><block type="multiple_purchase" id="tp2_over4_once">
            <field name="PURCHASE_1">DIGITOVER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
            <field name="PREDICTION">4</field>
          </block></statement>
          <value name="IF3"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
          <statement name="DO3"><block type="multiple_purchase" id="tp2_under5_first">
            <field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
            <field name="PREDICTION">5</field>
          </block></statement>
          <value name="IF4"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value>
          <statement name="DO4"><block type="multiple_purchase" id="tp2_under5_second">
            <field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
            <field name="PREDICTION">5</field>
          </block></statement>
          <value name="IF5"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
          <statement name="DO5"><block type="multiple_purchase" id="tp2_under5_third">
            <field name="PURCHASE_1">DIGITUNDER</field><field name="PURCHASE_2"/><field name="PURCHASE_3"/><field name="PURCHASE_4"/><field name="PURCHASE_5"/><field name="PURCHASE_6"/>
            <field name="PREDICTION">5</field>
          </block></statement>
        </block></next>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="tp2_after" deletable="false" x="850" y="0">
    <statement name="AFTERPURCHASE_STACK">
      <block type="king_fisher_restart_trade" id="tp2_session_limits">
        <field name="MULTIPLIER">1</field>
        <value name="TAKE_PROFIT"><block type="variables_get"><field name="VAR" id="tp2_tp">take_profit</field></block></value>
        <value name="STOP_LOSS"><block type="variables_get"><field name="VAR" id="tp2_sl">stop_loss</field></block></value>
        <next><block type="controls_if" id="tp2_toggle_pair"><mutation elseif="1"/>
          <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
          <statement name="DO0"><block type="variables_set" id="tp2_switch_to_under">
            <field name="VAR" id="tp2_phase">recovery_phase</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
          </block></statement>
          <value name="IF1"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_get"><field name="VAR" id="tp2_phase">recovery_phase</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
          <statement name="DO1"><block type="variables_set" id="tp2_switch_to_over">
            <field name="VAR" id="tp2_phase">recovery_phase</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
          </block></statement>
          <next><block type="king_fisher_recovery_escalation" id="tp2_recovery">
            <field name="PHASE" id="tp2_phase">recovery_phase</field>
            <field name="LOSS_COUNT" id="tp2_loss_count">paired_loss_count</field>
            <field name="RECOVERY_PHASE">0</field>
            <field name="RECOVERY_PHASE_2">1</field>
            <field name="INTERMEDIATE_PHASE_1">2</field>
            <field name="INTERMEDIATE_PHASE_2">3</field>
            <field name="FIRST_OVER3_PHASE">4</field>
            <field name="SECOND_OVER3_PHASE">5</field>
            <field name="RETURN_PHASE">0</field>
            <field name="USE_PAIR_RESULT">TRUE</field>
          </block></next>
        </block></next>
      </block>
    </statement>
  </block>
</xml>